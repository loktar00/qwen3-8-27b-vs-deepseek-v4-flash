+  const getLiveCells = () => {
+    const cells = new Set()
+    const rows = Array.from(document.querySelectorAll('tbody tr'))
+    rows.forEach((tr, y) => {
+      Array.from(tr.children).forEach((td, x) => {
+        if (td.getAttribute('data-testid').includes('well__cell--live')) {
+          cells.add(`${y},${x}`)
+        }
+      })
+    })
+    return cells
+  }
