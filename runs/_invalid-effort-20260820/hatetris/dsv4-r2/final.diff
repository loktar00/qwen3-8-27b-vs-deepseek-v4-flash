+
+  it('lets you keep playing from the replayed state after an incomplete replay ends', async () => {
+    // Reference: a fresh game with the same single move applied by hand
+    const reference = renderGame()
+    await user.click(screen.getByTestId('start-button'))
+    await user.keyboard('{Down}')
+    const expectedCells = getLiveCells()
+    reference.unmount()
+
+    // Now the same move, but supplied as an incomplete replay
+    const game = renderGame()
+    const prompt = sinon.stub(window, 'prompt')
+    prompt.returns('D')
+    await user.click(screen.getByTestId('replay-button'))
+    assert.deepEqual(prompt.getCalls().map(call => call.args), [
+      ['Paste replay string...']
+    ])
+    prompt.restore()
+
+    // Play the single replay move
+    await advanceReplaySteps(1)
+
+    // The game is not stuck in replay mode: the play controls are back
+    assert.equal(screen.queryAllByTestId('down').length, 1)
+
+    // The board is exactly the state reached by the replay, not a reset one: it
+    // matches a fresh game after the same move was applied by hand
+    assert.deepEqual(getLiveCells(), expectedCells)
+
+    // And the user can continue playing from that state
+    await user.keyboard('{Down}')
+    assert.equal(getLiveCells().size, expectedCells.size)
+
+    game.unmount()
+  })
 })
