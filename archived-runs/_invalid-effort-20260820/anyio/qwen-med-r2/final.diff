diff --git a/tests/test_synchronization.py b/tests/test_synchronization.py
index 3ead3c2..e1e1e81 100644
--- a/tests/test_synchronization.py
+++ b/tests/test_synchronization.py
@@ -993,3 +993,60 @@ class TestCapacityLimiter:
         limiter.acquire_on_behalf_of_nowait(borrower1)
         with pytest.raises(WouldBlock):
             limiter.acquire_on_behalf_of_nowait(borrower2)
+
+    @pytest.mark.parametrize("anyio_backend", asyncio_params)
+    async def test_acquire_nowait_while_token_reserved_for_waiter(self) -> None:
+        """A non-blocking acquire must not succeed in the window between a
+        release waking the next waiter and the waiter resuming. The freed
+        token is reserved for the woken waiter at notify time, so a
+        synchronous acquire in that window must raise ``WouldBlock``."""
+        limiter = CapacityLimiter(1)
+        borrower_a, borrower_b, borrower_x = object(), object(), object()
+        limiter.acquire_on_behalf_of_nowait(borrower_a)
+
+        async with create_task_group() as tg:
+            async def b() -> None:
+                await limiter.acquire_on_behalf_of(borrower_b)
+
+            tg.start_soon(b)
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 1
+
+            limiter.release_on_behalf_of(borrower_a)
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait(borrower_x)
+
+        # borrower_b holds the only token; no over-granting
+        assert limiter.borrowed_tokens == 1
+        assert limiter.available_tokens == 0
+
+    @pytest.mark.parametrize("anyio_backend", asyncio_params)
+    async def test_acquire_nowait_while_token_reserved_by_total_increase(self) -> None:
+        """Raising ``total_tokens`` wakes a waiter and reserves the new token
+        for it at notify time, so a synchronous acquire in the window before
+        the waiter resumes must raise ``WouldBlock``."""
+        limiter = CapacityLimiter(1)
+        borrower_a, borrower_b, borrower_x = object(), object(), object()
+        limiter.acquire_on_behalf_of_nowait(borrower_a)
+
+        async with create_task_group() as tg:
+            async def b() -> None:
+                await limiter.acquire_on_behalf_of(borrower_b)
+
+            tg.start_soon(b)
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 1
+
+            limiter.total_tokens = 2
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait(borrower_x)
+
+        # borrower_a and borrower_b hold the two tokens; no over-granting
+        assert limiter.borrowed_tokens == 2
+        assert limiter.available_tokens == 0
+
+        # the reserved token was actually handed to borrower_b
+        limiter.release_on_behalf_of(borrower_b)
+        limiter.acquire_on_behalf_of_nowait(borrower_x)
+        assert limiter.borrowed_tokens == 2
+        assert limiter.available_tokens == 0
