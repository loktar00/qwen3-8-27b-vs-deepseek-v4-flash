diff --git a/tests/resize-observer.test.ts b/tests/resize-observer.test.ts
new file mode 100644
index 0000000..4319a25
--- /dev/null
+++ b/tests/resize-observer.test.ts
@@ -0,0 +1,54 @@
+import { Chessground } from '../src/chessground';
+
+// jsdom does not implement ResizeObserver. This fake tracks live instances so
+// tests can assert that chessground disconnects its observers.
+class FakeResizeObserver {
+  static instances = new Set<FakeResizeObserver>();
+
+  constructor(private readonly callback: ResizeObserverCallback) {
+    FakeResizeObserver.instances.add(this);
+  }
+
+  observe(): void {}
+  unobserve(): void {}
+  disconnect(): void {
+    FakeResizeObserver.instances.delete(this);
+  }
+}
+
+beforeEach(() => {
+  FakeResizeObserver.instances.clear();
+  (window as any).ResizeObserver = FakeResizeObserver;
+});
+
+afterEach(() => {
+  delete (window as any).ResizeObserver;
+});
+
+const makeWrap = (): HTMLDivElement => {
+  const wrap = document.createElement('div');
+  wrap.style.cssText = 'width:200px;height:200px';
+  document.body.appendChild(wrap);
+  return wrap;
+};
+
+test('destroy disconnects the ResizeObserver', () => {
+  const wrap = makeWrap();
+  const cg = Chessground(wrap, { viewOnly: true });
+  expect(FakeResizeObserver.instances.size).toBe(1);
+  cg.destroy();
+  expect(FakeResizeObserver.instances.size).toBe(0);
+  wrap.remove();
+});
+
+test('redraw disconnects the previous ResizeObserver', () => {
+  const wrap = makeWrap();
+  const cg = Chessground(wrap, { viewOnly: true });
+  expect(FakeResizeObserver.instances.size).toBe(1);
+  // a config change that rebuilds the board DOM
+  cg.set({ orientation: 'black' });
+  expect(FakeResizeObserver.instances.size).toBe(1);
+  cg.destroy();
+  expect(FakeResizeObserver.instances.size).toBe(0);
+  wrap.remove();
+});
