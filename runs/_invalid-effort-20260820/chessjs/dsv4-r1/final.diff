+import { Chess } from './src/chess'
+
+// black pawn on a1 (edge rank 1) and h1
+for (const sq of ['a1', 'h1', 'a8', 'h8']) {
+  for (const [color, type] of [['b', 'p'], ['w', 'p']]) {
+    const chess = new Chess()
+    chess.turn = color as any
+    chess.put({ type: type as any, color: color as any }, sq as any)
+    try {
+      const m = chess.moves({ square: sq as any, verbose: true })
+      console.log(`black? ${color} pawn on ${sq}:`, m.map((x: any) => x.san).join(', ') || '(none)')
+    } catch (e) {
+      console.log(`ERROR ${color} pawn on ${sq}: ${e.message}`)
+    }
+  }
+}
