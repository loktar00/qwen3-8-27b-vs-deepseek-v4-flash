+  afterEach(cleanup);
+
+  it('should not re-invoke the ref on unrelated re-renders', async () => {
+    const triggerRef = vi.fn();
+
+    const App = () => {
+      const [count, setCount] = React.useState(0);
+      return (
+        <>
+          <button type="button" onClick={() => setCount((c) => c + 1)}>
