+import { describe, expect, it } from 'vitest'
+import { Chess } from '../src/chess'
+
+describe('pawns on edge ranks', () => {
+  it('does not generate off-board moves for a white pawn on h8', () => {
+    const chess = new Chess()
+    chess.put({ type: 'p', color: 'w' }, 'h8')
+
+    expect(chess.moves({ square: 'h8' })).toEqual([])
+    expect(chess.moves({ square: 'h8', verbose: true })).toEqual([])
+  })
+
+  it('does not generate off-board moves for a black pawn on a1', () => {
+    const chess = new Chess()
+    chess.put({ type: 'p', color: 'b' }, 'a1')
+    chess.setTurn('b')
+
+    expect(chess.moves({ square: 'a1' })).toEqual([])
+    expect(chess.moves({ square: 'a1', verbose: true })).toEqual([])
+  })
+
+  it('keeps promotions for a white pawn on h7', () => {
+    const chess = new Chess()
+    chess.clear()
+    chess.put({ type: 'p', color: 'w' }, 'h7')
+
+    const moves = chess.moves({ square: 'h7', verbose: true })
+
+    expect(moves).toHaveLength(4)
+    expect(moves.map((move) => move.promotion).sort()).toEqual([
+      'b',
+      'n',
+      'q',
+      'r',
+    ])
+
+    for (const move of moves) {
+      expect(move.from).toBe('h7')
+      expect(move.to).toBe('h8')
+    }
+  })
+
+  it('keeps promotions for a black pawn on a2', () => {
+    const chess = new Chess()
+    chess.clear()
+    chess.put({ type: 'p', color: 'b' }, 'a2')
+    chess.setTurn('b')
+
+    const moves = chess.moves({ square: 'a2', verbose: true })
+
+    expect(moves).toHaveLength(4)
+    expect(moves.map((move) => move.promotion).sort()).toEqual([
+      'b',
+      'n',
+      'q',
+      'r',
+    ])
+
+    for (const move of moves) {
+      expect(move.from).toBe('a2')
+      expect(move.to).toBe('a1')
+    }
+  })
+})
