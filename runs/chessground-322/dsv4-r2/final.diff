@@ -0,0 +1,61 @@
+import * as drag from '../src/drag';
+import { defaults, type State } from '../src/state';
+import type * as cg from '../src/types';
+import { computeSquareCenter } from '../src/util';
+
+const bounds: DOMRectReadOnly = { left: 0, top: 0, width: 320, height: 320 } as DOMRectReadOnly;
+
+const makeState = (pieces: cg.Pieces): State => {
+  const s = defaults() as State;
+  s.dom = {
+    elements: {
+      board: document.createElement('div'),
+      wrap: document.createElement('div'),
+      container: document.createElement('div'),
+    },
+    bounds: Object.assign(() => bounds, { clear: () => {} }),
+    redraw: () => {},
+    redrawNow: () => {},
+  };
+  s.trustAllEvents = true;
+  s.pieces = pieces;
+  s.drawable.shapes = [{ orig: 'e4', brush: 'green' }];
+  return s;
+};
+
+const mousedownAt = (square: cg.Key): cg.MouchEvent => {
+  const [x, y] = computeSquareCenter(square, true, bounds);
+  return new MouseEvent('mousedown', { clientX: x, clientY: y, button: 0, buttons: 1 }) as cg.MouchEvent;
+};
+
+const click = (s: State, square: cg.Key): void => {
+  drag.start(s, mousedownAt(square));
+};
+
+test('clicking an empty square clears shapes by default', () => {
+  const s = makeState(new Map());
+  click(s, 'a1');
+  expect(s.drawable.shapes).toEqual([]);
+});
+
+test('eraseOnClick true clears shapes when clicking an empty square', () => {
+  const s = makeState(new Map());
+  s.drawable.eraseOnClick = true;
+  click(s, 'a1');
+  expect(s.drawable.shapes).toEqual([]);
+});
+
+test('eraseOnClick false keeps shapes when clicking an empty square', () => {
+  const s = makeState(new Map());
+  s.drawable.eraseOnClick = false;
+  click(s, 'a1');
+  expect(s.drawable.shapes).toHaveLength(1);
+});
+
+test('eraseOnClick false keeps shapes when clicking an enemy piece', () => {
+  const s = makeState(new Map([['a1', { role: 'knight', color: 'black' }]]));
+  s.turnColor = 'white';
+  s.drawable.eraseOnClick = false;
+  click(s, 'a1');
+  expect(s.drawable.shapes).toHaveLength(1);
+});
