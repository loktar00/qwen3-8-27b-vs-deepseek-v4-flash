+describe('Slot with a stateful ref and a re-rendering parent (React 19)', () => {
+  afterEach(cleanup);
+
+  const refSpy = vi.fn();
+
+  const RefLoopProbe = () => {
+    const [text, setText] = React.useState('');
+    const [size, setSize] = React.useState<{ width: number; height: number } | null>(null);
+    const ref = React.useCallback((node: HTMLElement | null) => {
+      // A fresh state value on every invocation, like `useSize` or Slate/Plate
+      // editor refs produce. Re-invoking it on every commit is what turns a
+      // per-render ref closure into an infinite update loop.
+      refSpy(node);
+      setSize(node ? { width: node.offsetWidth, height: node.offsetHeight } : null);
+    }, []);
+
+    return (
+      <>
+        <input
+          aria-label="type here"
+          onChange={(event) => setText(event.target.value)}
+          value={text}
+        />
+        <Slot ref={ref}>
+          <button type="button">hi</button>
+        </Slot>
+        <span data-testid="size">{size ? `${size.width}x${size.height}` : 'none'}</span>
+      </>
+    );
+  };
+
+  it('does not re-invoke the ref on every re-render', async () => {
+    refSpy.mockReset();
+    render(<RefLoopProbe />);
+    // Before the fix this threw "Maximum update depth exceeded": each keystroke
+    // re-rendered the tree, Slot attached a new composed ref closure, React
+    // re-invoked the ref, the ref set state, which rendered again — forever.
+    await userEvent.type(screen.getByRole('textbox', { name: 'type here' }), 'foo');
+    expect(refSpy).toHaveBeenCalledTimes(1);
+    expect(screen.getByTestId('size')).toHaveTextContent('0x0');
+  });
+});
