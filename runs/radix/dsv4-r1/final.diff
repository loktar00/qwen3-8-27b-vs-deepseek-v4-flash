+describe('composeRefs React 19 ref cleanup regression', () => {
+  afterEach(cleanup);
+
+  // Regression guard for the React 19 "Maximum update depth exceeded" bug reported against
+  // `@radix-ui/react-compose-refs` 1.1.0. When a ref callback returns a cleanup
+  // function (React 19 feature), the composed Slot ref must forward and invoke it on detach.
+  // Fixed upstream in https://github.com/radix-ui/primitives/pull/3283 and #3285.
+  it('invokes a child ref cleanup when the composed Slot ref detaches', () => {
+    let cleanedUp = false;
+    const slotRef = vi.fn();
+    const childRef = () => () => {
+      cleanedUp = true;
+    };
+
+    const { unmount } = render(
+      <Slot ref={slotRef}>
+        <button ref={childRef} type="button">
+          hi
+        </button>
+      </Slot>,
+    );
+
+    const button = screen.getByRole('button');
+    expect(slotRef).toHaveBeenCalledWith(button);
+    expect(cleanedUp).toBe(false);
+
+    unmount();
+    expect(cleanedUp).toBe(true);
+  });
+
+  // When no `forwardedRef` is passed to `Slot`, it attaches the child's own ref directly
+  // (no `composeRefs` wrapping), so React 19 must still invoke that callback's returned
+  // cleanup on detach — behavior must be unchanged from before the composeRefs fix.
+  it('invokes the child ref cleanup on unmount even without a forwarded Slot ref', () => {
+    let cleanedUp = false;
+
+    const { unmount } = render(
+      <Slot>
+        <button
+          ref={() => () => {
+            cleanedUp = true;
+          }}
+          type="button"
+        >
+          hi
+        </button>
+      </Slot>,
+    );
+
+    expect(cleanedUp).toBe(false);
+
+    unmount();
+    expect(cleanedUp).toBe(true);
+  });
+});
+
