+    onStartEdit: () => void;
+    onSave: () => void;
+    onCancel: () => void;
+};
+
+// The right half of the PINNED heading: an Edit button that flips the section
+// into edit mode, then Save/Cancel once editing.
+export const PinnedEditHeading = ({ isEditMode, onStartEdit, onSave, onCancel }: PinnedEditHeadingProps) => {
+    if (!isEditMode) {
+        return (
+            <button type="button" className="contact_list__edit_button" onClick={onStartEdit}>
