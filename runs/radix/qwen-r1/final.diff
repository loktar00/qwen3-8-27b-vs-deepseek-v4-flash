+describe('given a Slot that re-renders (React 19 ref behavior)', () => {
+  afterEach(cleanup);
+
+  it('should not re-invoke a stable ref callback on re-render', () => {
+    const handleRef = vi.fn();
+    function Wrapper() {
+      const [count, setCount] = React.useState(0);
+      return (
+        <Slot ref={handleRef}>
+          <button type="button" onClick={() => setCount((c) => c + 1)}>
+            {count}
+          </button>
+        </Slot>
+      );
+    }
+    render(<Wrapper />);
+    const button = screen.getByRole('button');
+    fireEvent.click(button);
+    fireEvent.click(button);
+    expect(handleRef).toHaveBeenCalledTimes(1);
+  });
+
+  it('should not exceed the update depth when the ref callback schedules an update', () => {
+    let renders = 0;
+    function App() {
+      renders++;
+      const [count, setCount] = React.useState(0);
+      const ref = React.useCallback(
+        (node: HTMLButtonElement | null) => {
+          if (node) setCount((c) => c + 1);
+        },
+        [],
+      );
+      return (
+        <Slot ref={ref}>
+          <button type="button">{count}</button>
+        </Slot>
+      );
+    }
+    const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
+    try {
+      render(<App />);
+    } finally {
+      errorSpy.mockRestore();
+    }
+    // Before the fix, Slot re-created the composed ref on every render and
+    // React re-attached it on every commit, so this never settled and React
+    // threw "Maximum update depth exceeded".
+    expect(renders).toBeLessThanOrEqual(3);
+  });
+});
+
+describe('given a Slot without a ref (no forwardedRef)', () => {
+  afterEach(cleanup);
+
+  it('should pass the child ref through unchanged (mount, re-render, unmount)', () => {
+    const childRef = vi.fn();
+    function Wrapper() {
+      const [count, setCount] = React.useState(0);
+      return (
+        <Slot>
+          <button type="button" ref={childRef} onClick={() => setCount((c) => c + 1)}>
+            {count}
+          </button>
+        </Slot>
+      );
+    }
+    const { unmount } = render(<Wrapper />);
+    const button = screen.getByRole('button');
+    expect(childRef).toHaveBeenCalledTimes(1);
+    expect(childRef).toHaveBeenCalledWith(button);
+    // re-render must not re-attach the child's own ref
+    fireEvent.click(button);
+    expect(childRef).toHaveBeenCalledTimes(1);
+    unmount();
+    expect(childRef).toHaveBeenCalledTimes(2);
+    // React's dev build detaches refs via a 5-arg passthrough wrapper, so
+    // assert on the node argument only (a real ref callback ignores extras).
+    expect(childRef.mock.lastCall?.[0]).toBe(null);
+  });
+
+  it('should keep an object ref attached to the child across re-renders', () => {
+    const childRef = React.createRef<HTMLButtonElement>();
+    function Wrapper() {
+      const [count, setCount] = React.useState(0);
+      return (
+        <Slot>
+          <button type="button" ref={childRef} onClick={() => setCount((c) => c + 1)}>
+            {count}
+          </button>
+        </Slot>
+      );
+    }
+    render(<Wrapper />);
+    const button = screen.getByRole('button');
+    expect(childRef.current).toBe(button);
+    fireEvent.click(button);
+    expect(childRef.current).toBe(button);
+  });
+});
