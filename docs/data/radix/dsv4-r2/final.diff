@@ -0,0 +1,16 @@
+---
+'@radix-ui/react-dismissable-layer': patch
+'@radix-ui/react-dropdown-menu': patch
+'@radix-ui/react-focus-scope': patch
+'@radix-ui/react-menu': patch
+'@radix-ui/react-navigation-menu': patch
+'@radix-ui/react-popper': patch
+'@radix-ui/react-radio-group': patch
+'@radix-ui/react-scroll-area': patch
+'@radix-ui/react-select': patch
+'@radix-ui/react-slider': patch
+'@radix-ui/react-switch': patch
+'@radix-ui/react-toast': patch
+---
+
+Stabilize composed ref identities to prevent React 19 re-render loops. Pass state setters directly to `useComposedRefs` instead of inline arrows, hoist render-inline `composeRefs` calls, and wrap closures that capture per-render values in `useCallbackRef`.
