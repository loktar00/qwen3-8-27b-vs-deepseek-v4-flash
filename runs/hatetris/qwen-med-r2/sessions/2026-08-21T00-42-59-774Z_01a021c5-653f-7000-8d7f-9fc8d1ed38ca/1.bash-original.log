-    const nextMode = gameIsOver ? 'GAME_OVER' : mode
+    // If we're replaying and the replay has run out of moves, and the
+    // game is still going, then the replay is over; hand control back
+    // to the player
+    let nextMode: string
+    if (gameIsOver) {
+      nextMode = 'GAME_OVER'
+    } else if (mode === 'REPLAYING' && !(nextWellStateId in nextReplay)) {
+      nextMode = 'PLAYING'
+    } else {
+      nextMode = mode
+    }
 
     // no live piece? make a new one
