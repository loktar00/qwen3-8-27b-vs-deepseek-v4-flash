+test('moves - single square - promotion - white pawn on seventh rank', () => {
+  const base = '8/8/8/8/k7/8/8/4K3 w - - 0 1'
+  const expected: Record<string, string> = {
+    a: 'a8=N a8=B a8=R+ a8=Q+',
+    b: 'b8=N b8=B b8=R b8=Q',
+    c: 'c8=N c8=B c8=R c8=Q',
+    d: 'd8=N d8=B d8=R d8=Q',
+    e: 'e8=N e8=B+ e8=R e8=Q+',
+    f: 'f8=N f8=B f8=R f8=Q',
+    g: 'g8=N g8=B g8=R g8=Q',
+    h: 'h8=N h8=B h8=R h8=Q',
+  }
+
+  for (const file of Object.keys(expected)) {
+    const chess = new Chess(base)
+    chess.put({ type: 'p', color: 'w' }, `${file}7` as Square)
+    expect(chess.moves({ square: `${file}7` as Square })).to.have.members(
+      split(expected[file]),
+    )
+  }
+})
+
+test('moves - single square - promotion - seventh-rank capture on edge files', () => {
+  const a7 = new Chess('8/8/8/8/k7/8/8/4K3 w - - 0 1')
+  a7.put({ type: 'p', color: 'b' }, 'b8')
+  a7.put({ type: 'p', color: 'w' }, 'a7')
+  expect(a7.moves({ square: 'a7' })).to.have.members(
+    split('a8=N a8=B a8=R+ a8=Q+ axb8=N axb8=B axb8=R axb8=Q'),
+  )
+
+  const h7 = new Chess('8/8/8/8/k7/8/8/4K3 w - - 0 1')
+  h7.put({ type: 'p', color: 'b' }, 'g8')
+  h7.put({ type: 'p', color: 'w' }, 'h7')
+  expect(h7.moves({ square: 'h7' })).to.have.members(
+    split('h8=N h8=B h8=R h8=Q hxg8=N hxg8=B hxg8=R hxg8=Q'),
+  )
+})
+
