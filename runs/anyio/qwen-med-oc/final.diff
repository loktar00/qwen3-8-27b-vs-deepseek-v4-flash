diff --git a/tests/test_synchronization.py b/tests/test_synchronization.py
index 3ead3c2..a3f5b0a 100644
--- a/tests/test_synchronization.py
+++ b/tests/test_synchronization.py
@@ -993,3 +993,66 @@ class TestCapacityLimiter:
         limiter.acquire_on_behalf_of_nowait(borrower1)
         with pytest.raises(WouldBlock):
             limiter.acquire_on_behalf_of_nowait(borrower2)
+
+    async def test_acquire_nowait_does_not_steal_token_reserved_for_waiter(self) -> None:
+        # Regression test: when a release hands a token to the first waiter, the
+        # token must be reserved for that waiter before it resumes, so that a
+        # non-blocking acquire in the meantime raises WouldBlock instead of
+        # letting the limiter over-grant
+        borrower_a, borrower_b, borrower_x = object(), object(), object()
+        limiter = CapacityLimiter(1)
+        acquired: list[object] = []
+
+        async def b() -> None:
+            await limiter.acquire_on_behalf_of(borrower_b)
+            acquired.append(borrower_b)
+
+        limiter.acquire_on_behalf_of_nowait(borrower_a)
+        async with create_task_group() as tg:
+            tg.start_soon(b)
+            while limiter.statistics().tasks_waiting != 1:
+                await wait_all_tasks_blocked()
+
+            limiter.release_on_behalf_of(borrower_a)
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait(borrower_x)
+
+        assert acquired == [borrower_b]
+        assert limiter.borrowed_tokens <= limiter.total_tokens
+        assert limiter.borrowed_tokens == 1
+        assert limiter.available_tokens == 0
+        assert limiter.statistics().borrowers == (borrower_b,)
+
+    @pytest.mark.parametrize("anyio_backend", asyncio_params)
+    async def test_increase_tokens_reserves_token_for_woken_waiter(self) -> None:
+        # Regression test: raising total_tokens hands a token to the first waiter
+        # and must reserve it for that waiter before it resumes, so that a
+        # non-blocking acquire in the meantime raises WouldBlock instead of
+        # letting the limiter over-grant
+        borrower_a, borrower_b, borrower_x = object(), object(), object()
+        limiter = CapacityLimiter(1)
+        acquired: list[object] = []
+
+        async def b() -> None:
+            await limiter.acquire_on_behalf_of(borrower_b)
+            acquired.append(borrower_b)
+
+        limiter.acquire_on_behalf_of_nowait(borrower_a)
+        async with create_task_group() as tg:
+            tg.start_soon(b)
+            while limiter.statistics().tasks_waiting != 1:
+                await wait_all_tasks_blocked()
+
+            # Wakes exactly one waiter, leaving no tokens generally available
+            limiter.total_tokens = 2
+            assert limiter.borrowed_tokens == 2
+            assert limiter.available_tokens == 0
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait(borrower_x)
+
+            limiter.release_on_behalf_of(borrower_a)
+
+        assert acquired == [borrower_b]
+        assert limiter.borrowed_tokens == 1
+        assert limiter.available_tokens == 1
+        assert limiter.statistics().borrowers == (borrower_b,)
