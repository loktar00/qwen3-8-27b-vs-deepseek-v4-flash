+  it('lets you keep playing after an incomplete replay runs out of moves', async () => {
+    const game = renderGame()
+
+    // Replay is a single move which does not end the game
+    const prompt = sinon.stub(window, 'prompt')
+    prompt.returns('D')
+    await user.click(screen.getByTestId('replay-button'))
+    assert.deepEqual(prompt.getCalls().map(call => call.args), [
+      ['Paste replay string...']
+    ])
+    prompt.restore()
+
+    // Play back the one move of the supplied replay
+    await advanceReplaySteps(1)
+
+    // The replay is finished but the game isn't over. The player must
+    // not be stuck on the "replaying..." screen: the move buttons must
+    // be back, and moves must work.
+    assert.equal(screen.queryAllByTestId('down').length, 1)
+
+    await user.keyboard('{Down}')
+    // The first piece is an S: after the replay's D plus this one,
+    // two of its cells are on the bar
+    assert.equal(screen.queryAllByTestId('well__cell well__cell--live').length, 2)
+    assert.equal(screen.queryAllByTestId('well__cell well__cell--bar well__cell--live').length, 2)
+
+    // The game loop keeps working past the end of the replay: the
+    // piece can still be dropped (15 more moves to the floor) and
+    // locked (the 16th Down), and a new piece is dealt in PLAYING mode
+    for (let i = 0; i < 16; i++) {
+      await user.keyboard('{Down}')
+    }
+    assert.equal(screen.queryAllByTestId('well__cell well__cell--landed').length, 4)
+    assert.equal(screen.queryAllByTestId('well__cell well__cell--live').length, 4)
+    assert.equal(screen.queryAllByTestId('down').length, 1)
+    game.unmount()
+  })
+
