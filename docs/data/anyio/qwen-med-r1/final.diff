diff --git a/src/anyio/_backends/_asyncio.py b/src/anyio/_backends/_asyncio.py
index bc7e6ab..2bf1345 100644
--- a/src/anyio/_backends/_asyncio.py
+++ b/src/anyio/_backends/_asyncio.py
@@ -2077,7 +2077,9 @@ class CapacityLimiter(BaseCapacityLimiter):
 
         # Notify waiting tasks that they have acquired the limiter
         while self._wait_queue and waiters_to_notify:
-            event = self._wait_queue.popitem(last=False)[1]
+            borrower, event = self._wait_queue.popitem(last=False)
+            # Hand the token to the waiter immediately (see _notify_next_waiter)
+            self._borrowers.add(borrower)
             event.set()
             waiters_to_notify -= 1
 
@@ -2092,7 +2094,11 @@ class CapacityLimiter(BaseCapacityLimiter):
     def _notify_next_waiter(self) -> None:
         """Notify the next task in line if this limiter has free capacity now."""
         if self._wait_queue and len(self._borrowers) < self._total_tokens:
-            event = self._wait_queue.popitem(last=False)[1]
+            borrower, event = self._wait_queue.popitem(last=False)
+            # Hand the token to the waiter now, so that a non-blocking
+            # acquire() issued while the waiter is still suspended sees no
+            # free token and raises WouldBlock instead of over-granting one.
+            self._borrowers.add(borrower)
             event.set()
 
     def acquire_nowait(self) -> None:
@@ -2122,9 +2128,15 @@ class CapacityLimiter(BaseCapacityLimiter):
             try:
                 await event.wait()
             except BaseException:
-                self._wait_queue.pop(borrower, None)
                 if event.is_set():
+                    # This borrower was already handed a token when its event
+                    # was set (it is in _borrowers); release it and pass the
+                    # token on to the next waiter in line.
+                    self._borrowers.remove(borrower)
                     self._notify_next_waiter()
+                else:
+                    # Still waiting in line with no token held; drop ourselves.
+                    self._wait_queue.pop(borrower, None)
 
                 raise
 
diff --git a/tests/test_synchronization.py b/tests/test_synchronization.py
index 3ead3c2..d6c239a 100644
--- a/tests/test_synchronization.py
+++ b/tests/test_synchronization.py
@@ -993,3 +993,56 @@ class TestCapacityLimiter:
         limiter.acquire_on_behalf_of_nowait(borrower1)
         with pytest.raises(WouldBlock):
             limiter.acquire_on_behalf_of_nowait(borrower2)
+
+    @pytest.mark.parametrize("anyio_backend", asyncio_params)
+    async def test_nowait_acquire_after_release_wakes_waiter(self) -> None:
+        # A non-blocking acquire issued after a release has woken a waiter --
+        # but before that waiter has resumed -- must not over-grant the token
+        # that is already reserved for the woken waiter.
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async with create_task_group() as tg:
+            async def waiter() -> None:
+                await limiter.acquire_on_behalf_of("B")
+
+            tg.start_soon(waiter)
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 1
+
+            # Free the token; this wakes "B", but "B" has not resumed yet, so
+            # "B" is the sole borrower and the wait queue is now empty.
+            limiter.release_on_behalf_of("A")
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        assert limiter.borrowed_tokens == 1
+        assert limiter.available_tokens == 0
+        assert limiter.statistics().borrowers == ("B",)
+
+    @pytest.mark.parametrize("anyio_backend", asyncio_params)
+    async def test_nowait_acquire_after_increase_wakes_waiter(self) -> None:
+        # A non-blocking acquire issued after a total_tokens increase has woken
+        # a waiter -- but before that waiter has resumed -- must not over-grant
+        # the token that is already reserved for the woken waiter.
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async with create_task_group() as tg:
+            async def waiter() -> None:
+                await limiter.acquire_on_behalf_of("B")
+
+            tg.start_soon(waiter)
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 1
+
+            # Raise the capacity; this wakes "B" and makes it a borrower, but
+            # "B" has not resumed yet and the wait queue is now empty.
+            limiter.total_tokens = 2
+            assert limiter.statistics().tasks_waiting == 0
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        assert limiter.borrowed_tokens == 2
+        assert limiter.available_tokens == 0
+        assert set(limiter.statistics().borrowers) == {"A", "B"}
