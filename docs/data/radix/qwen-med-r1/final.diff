@@ -0,0 +1,51 @@
+import * as React from 'react';
+import { cleanup, render, screen } from '@testing-library/react';
+import { afterEach, describe, it, vi, expect } from 'vitest';
+import {
+  DropdownMenu,
+  DropdownMenuTrigger,
+  DropdownMenuContent,
+  DropdownMenuItem,
+} from './dropdown-menu';
+
+describe('DropdownMenuTrigger ref stability', () => {
+  afterEach(cleanup);
+
+  it('does not re-invoke a stable ref callback when the trigger re-renders', () => {
+    const handleRef = vi.fn();
+    const Wrapper = ({ label }: { label: string }) => (
+      <DropdownMenu>
+        <DropdownMenuTrigger ref={handleRef}>{label}</DropdownMenuTrigger>
+        <DropdownMenuContent>
+          <DropdownMenuItem>Item</DropdownMenuItem>
+        </DropdownMenuContent>
+      </DropdownMenu>
+    );
+
+    const { rerender } = render(<Wrapper label="a" />);
+    expect(handleRef).toHaveBeenCalledTimes(1);
+    expect(handleRef).toHaveBeenCalledWith(screen.getByRole('button'));
+
+    rerender(<Wrapper label="b" />);
+    expect(handleRef).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not create an update loop when the ref callback triggers a state update', () => {
+    const Comp = () => {
+      const [count, setCount] = React.useState(0);
+      const ref = React.useCallback((node: HTMLButtonElement | null) => {
+        if (node) setCount((c) => c + 1);
+      }, []);
+      return (
+        <DropdownMenu>
+          <DropdownMenuTrigger ref={ref} data-count={count}>
+            Open
+          </DropdownMenuTrigger>
+        </DropdownMenu>
+      );
+    };
+
+    render(<Comp />);
+    expect(screen.getByRole('button')).toHaveAttribute('data-count', '1');
+  });
+});
