+import { DotsSixVertical } from '@phosphor-icons/react';
+import type { GroupChannel } from '@sendbird/chat/groupChannel';
+import { useSendbirdStateContext } from '@sendbird/uikit-react';
+import { useGetEntities } from 'called-api/src/openApi/calledApiComponents';
+import { useChannelsList } from '@/hooks/useChannelsList';
+import { useChannelAvatar } from '@/hooks/useChannelAvatar';
+import { getChannelName } from '@/utils/channel';
+import { ChannelAvatar } from '@/components/ChannelAvatar/ChannelAvatar';
+
+import styles from './PinnedEditRow.module.scss';
+
+type PinnedEditRowProps = {
+    channel: GroupChannel;
+    isPinned: boolean;
+    onTogglePin: (url: string, isPinned: boolean) => void;
+};
+
+export const PinnedEditRow = ({ channel, isPinned, onTogglePin }: PinnedEditRowProps) => {
+    // Only pinned rows are sortable; unpinned rows just get a checkbox.
+    const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({
+        id: channel.url,
+        disabled: !isPinned,
+    });
+
+    const { stores } = useSendbirdStateContext();
+    const currentUserId = stores.userStore.user.userId;
+    const { data: entitiesData } = useGetEntities({});
+    const { data: channelsData } = useChannelsList();
+
+    // Avatars stay on edit rows so near-identical names remain tellable apart
+    const avatarUrl = useChannelAvatar(channel, currentUserId);
+    const isPublicChannel = !entitiesData?.items?.some((entity) => entity.channelUrl === channel?.url);
+    const channelApiData = channelsData?.items?.find((ch) => ch.channelUrl === channel?.url);
+    const isPrivateChannel = channelApiData?.type === 'ENTITY_PRIVATE';
+    const name = getChannelName(channel, currentUserId);
+
+    const style: CSSProperties = {
+        transform: CSS.Translate.toString(transform),
+        transition,
+    };
+
+    const handleToggle = () => onTogglePin(channel.url, !isPinned);
+
+    return (
+        <div
+            ref={setNodeRef}
+            style={style}
+            className={`${styles.edit_row} ${isPinned ? styles.edit_row_pinned : ''} ${isDragging ? styles.edit_row_dragging : ''}`}>
+            <input
+                type="checkbox"
+                className={styles.checkbox}
+                checked={isPinned}
+                onChange={handleToggle}
+                aria-label={`${isPinned ? 'Unpin' : 'Pin'} ${name}`} />
+            <div className={styles.avatar_container}>
+                <ChannelAvatar
+                    imageGuid={avatarUrl}
+                    size={40}
+                    channel={channel}
+                    isPublicChannel={isPublicChannel}
+                    isPrivateChannel={isPrivateChannel} />
+            </div>
+            <span className={styles.name}>{name}</span>
+            {isPinned && (
+                <button
+                    type="button"
+                    className={styles.drag_handle}
+                    aria-label={`Reorder ${name} in pinned chats`}
+                    {...attributes}
+                    {...listeners}>
+                    <DotsSixVertical size={18} />
+                </button>
+            )}
+        </div>
+    );
+};
