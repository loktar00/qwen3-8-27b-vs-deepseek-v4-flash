@@ -0,0 +1,38 @@
+import * as drag from '../src/drag';
+import * as fen from '../src/fen';
+import { defaults, type State } from '../src/state';
+import type * as cg from '../src/types';
+
+const bounds = { left: 0, top: 0, width: 8, height: 8 } as DOMRectReadOnly;
+
+const makeState = (eraseOnClick: boolean): State => {
+  const state = defaults() as State;
+  state.trustAllEvents = true;
+  state.pieces = fen.read('8/8/8/8/8/8/8/8 w - - 0 1');
+  state.drawable.eraseOnClick = eraseOnClick;
+  state.drawable.shapes = [{ orig: 'e4', dest: 'e5' }];
+  state.dom = {
+    bounds: () => bounds,
+    redraw: () => {},
+    redrawNow: () => {},
+    elements: { ghost: undefined, board: { firstChild: null } },
+  } as unknown as cg.Dom;
+  return state;
+};
+
+const click = (clientX: number, clientY: number): cg.MouchEvent =>
+  ({ isTrusted: true, clientX, clientY, buttons: 0, preventDefault: () => {} }) as cg.MouchEvent;
+
+describe('erase on click', () => {
+  test('eraseOnClick true clears shapes when clicking an empty square', () => {
+    const state = makeState(true);
+    drag.start(state, click(0.5, 7.5)); // empty square a1
+    expect(state.drawable.shapes).toEqual([]);
+  });
+
+  test('eraseOnClick false keeps shapes when clicking an empty square', () => {
+    const state = makeState(false);
+    drag.start(state, click(0.5, 7.5)); // empty square a1
+    expect(state.drawable.shapes).toHaveLength(1);
+  });
+});
