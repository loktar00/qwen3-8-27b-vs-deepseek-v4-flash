diff --git a/tests/test_synchronization.py b/tests/test_synchronization.py
index 3ead3c2..bbf4363 100644
--- a/tests/test_synchronization.py
+++ b/tests/test_synchronization.py
@@ -993,3 +993,58 @@ class TestCapacityLimiter:
         limiter.acquire_on_behalf_of_nowait(borrower1)
         with pytest.raises(WouldBlock):
             limiter.acquire_on_behalf_of_nowait(borrower2)
+
+    async def test_acquire_nowait_with_reserved_token(self) -> None:
+        # A non-blocking acquire must not steal a token that has already been
+        # reserved for a woken (but not yet resumed) waiter
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async def waiter() -> None:
+            try:
+                await limiter.acquire_on_behalf_of("B")
+            finally:
+                limiter.release_on_behalf_of("B")
+
+        async with create_task_group() as tg:
+            tg.start_soon(waiter)
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 1
+
+            # Free the token. The waiter is woken and the token is reserved
+            # for it, so a non-blocking acquire in this window must fail.
+            limiter.release_on_behalf_of("A")
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        assert limiter.borrowed_tokens == 0
+        assert limiter.available_tokens == limiter.total_tokens
+
+    async def test_acquire_nowait_with_reserved_token_from_increase(self) -> None:
+        # A non-blocking acquire must not steal a token that has already been
+        # reserved for a waiter woken by a total_tokens increase
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async def waiter() -> None:
+            try:
+                await limiter.acquire_on_behalf_of("B")
+            finally:
+                limiter.release_on_behalf_of("B")
+
+        async with create_task_group() as tg:
+            tg.start_soon(waiter)
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 1
+
+            # Wakes the waiter and reserves a token for it, so a
+            # non-blocking acquire in this window must fail even though the
+            # total capacity is larger than the number of resumed borrowers
+            limiter.total_tokens = 2
+            assert limiter.available_tokens == 0
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        limiter.release_on_behalf_of("A")
+        assert limiter.borrowed_tokens == 0
+        assert limiter.available_tokens == limiter.total_tokens
