diff --git a/tests/test_synchronization.py b/tests/test_synchronization.py
index 3ead3c2..18c7bc8 100644
--- a/tests/test_synchronization.py
+++ b/tests/test_synchronization.py
@@ -993,3 +993,65 @@ class TestCapacityLimiter:
         limiter.acquire_on_behalf_of_nowait(borrower1)
         with pytest.raises(WouldBlock):
             limiter.acquire_on_behalf_of_nowait(borrower2)
+
+    async def test_nowait_acquire_cannot_steal_woken_waiters_token(self) -> None:
+        # Regression test: a non-blocking acquire issued right after a release
+        # must not steal a token that has already been handed to a woken but
+        # not-yet-resumed waiter
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async with create_task_group() as tg:
+            async def borrower() -> None:
+                async with limiter:
+                    await checkpoint()
+
+            tg.start_soon(borrower)
+
+            while limiter.statistics().tasks_waiting != 1:
+                await checkpoint()
+
+            # Free the only token; the waiter is woken but has not resumed yet,
+            # so no token is available to a non-blocking acquire
+            limiter.release_on_behalf_of("A")
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+            assert limiter.borrowed_tokens == 1
+            assert limiter.available_tokens == 0
+
+        # The token must have gone to the woken waiter, which released it
+        assert limiter.borrowed_tokens == 0
+        assert limiter.statistics().borrowers == ()
+
+    async def test_increase_tokens_cannot_steal_reserved_waiters_tokens(self) -> None:
+        # Regression test: a non-blocking acquire issued right after raising
+        # total_tokens must not steal tokens that have already been handed to
+        # woken but not-yet-resumed waiters
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async with create_task_group() as tg:
+            async def borrower() -> None:
+                async with limiter:
+                    await checkpoint()
+
+            tg.start_soon(borrower)
+            tg.start_soon(borrower)
+
+            while limiter.statistics().tasks_waiting != 2:
+                await checkpoint()
+
+            # Raise the capacity; both waiters are woken but have not resumed
+            # yet, so no token is available to a non-blocking acquire
+            limiter.total_tokens = 3
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+            assert limiter.borrowed_tokens == 3
+            assert limiter.available_tokens == 0
+
+        # The woken waiters acquired and released their tokens; release "A" too
+        limiter.release_on_behalf_of("A")
+        assert limiter.borrowed_tokens == 0
+        assert limiter.statistics().borrowers == ()
