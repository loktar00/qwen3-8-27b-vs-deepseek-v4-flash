index 00000000..d64fdbdb
--- /dev/null
+++ b/packages/react/navigation-menu/src/repro-nav.test.tsx
@@ -0,0 +1,73 @@
+import * as React from 'react';
+import { render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import {
+  NavigationMenu,
+  NavigationMenuList,
+  NavigationMenuItem,
+  NavigationMenuTrigger,
+  NavigationMenuContent,
+  NavigationMenuViewport,
+} from './navigation-menu';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+afterEach(() => {
+  cleanup();
+});
+
+import { cleanup } from '@testing-library/react';
+
+describe('repro', () => {
+  it('logs ref call stacks', async () => {
+    const calls: { isNull: boolean; stack: string }[] = [];
+    Error.stackTraceLimit = 100;
+    const contentRef = vi.fn((node) => {
+      calls.push({ isNull: node === null, stack: new Error('ref-call').stack ?? '' });
+    });
+
+    const Probe = React.forwardRef<HTMLDivElement, { name: string }>((props, ref) => {
+      React.useEffect(() => {
+        console.log('[DBG] PROBE MOUNT', props.name);
+        return () => console.log('[DBG] PROBE UNMOUNT', props.name);
+      }, [props.name]);
+      return <div ref={ref} data-probe={props.name} />;
+    });
+    const App = () => {
+      const [count, setCount] = React.useState(0);
+      return (
+        <>
+          <button type="button" onClick={() => setCount((c) => c + 1)}>
+            bump {count}
+          </button>
+          <NavigationMenu>
+            <NavigationMenuList>
+              <NavigationMenuItem value="a">
+                <NavigationMenuTrigger>A</NavigationMenuTrigger>
+                <NavigationMenuContent value="a" forceMount ref={contentRef}>
+                  <div>Content A</div>
+                  <Probe name="content" />
+                </NavigationMenuContent>
+              </NavigationMenuItem>
+            </NavigationMenuList>
+            <NavigationMenuViewport forceMount>
+              <Probe name="viewport" />
+            </NavigationMenuViewport>
+          </NavigationMenu>
+        </>
+      );
+    };
+
+    render(<App />);
+    const afterRender = contentRef.mock.calls.length;
+    await userEvent.click(screen.getByRole('button', { name: 'bump 0' }));
+    const afterBump = contentRef.mock.calls.length;
+    const fs = await import('node:fs');
+    fs.writeFileSync(
+      'repro-nav-stacks.txt',
+      calls
+        .map((c, i) => `=== call ${i} null=${c.isNull} ===\n${c.stack}\n`)
+        .join('\n'),
+    );
+    expect(afterRender).toBe(1);
+  });
+});
