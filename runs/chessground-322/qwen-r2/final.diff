+import { type Api, Chessground } from '../src/chessground';
+import type { Config } from '../src/config';
+import type * as cg from '../src/types';
+
+// jsdom has no layout: give the board a fixed size so that
+// board.getKeyAtDomPos() can resolve clicks to squares.
+const SIZE = 320;
+const SQ = SIZE / 8;
+const rect = {
+  left: 0,
+  top: 0,
+  width: SIZE,
+  height: SIZE,
+  right: SIZE,
+  bottom: SIZE,
+  x: 0,
+  y: 0,
+  toJSON: () => ({}),
+} as DOMRect;
+
+const instances: { chess: Api; wrap: HTMLElement }[] = [];
+
+function setup(config: Config = {}): { chess: Api; boardEl: HTMLElement } {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const chess = Chessground(wrap, {
+    trustAllEvents: true, // dispatched events have isTrusted = false
+    ...config,
+  });
+  const boardEl = wrap.querySelector('cg-board') as HTMLElement;
+  boardEl.getBoundingClientRect = () => rect;
+  chess.state.dom.bounds.clear();
+  instances.push({ chess, wrap });
+  return { chess, boardEl };
+}
+
+function click(boardEl: HTMLElement, key: cg.Key): void {
+  const file = key.charCodeAt(0) - 97;
+  const rank = key.charCodeAt(1) - 49;
+  const x = file * SQ + SQ / 2;
+  const y = SIZE - (rank * SQ + SQ / 2);
+  boardEl.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, clientX: x, clientY: y }));
+  document.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, clientX: x, clientY: y }));
+}
+
+function withArrow(chess: Api): void {
+  chess.setShapes([{ orig: 'e4', dest: 'e5', brush: 'blue' }]);
+  expect(chess.state.drawable.shapes).toHaveLength(1);
+}
+
+afterEach(() => {
+  while (instances.length) {
+    const { chess, wrap } = instances.pop()!;
+    chess.destroy();
+    wrap.remove();
+  }
+});
+
+describe('default erase-on-click behavior (regression guard)', () => {
+  test('clicking an empty square erases all shapes', () => {
+    const { chess, boardEl } = setup();
+    withArrow(chess);
+    click(boardEl, 'd4');
+    expect(chess.state.drawable.shapes).toHaveLength(0);
+  });
+
+  test('clicking an immovable piece erases all shapes', () => {
+    const { chess, boardEl } = setup();
+    withArrow(chess);
+    click(boardEl, 'd7');
+    expect(chess.state.drawable.shapes).toHaveLength(0);
+  });
+
+  test('clicking a movable piece erases all shapes', () => {
+    const { chess, boardEl } = setup();
+    withArrow(chess);
+    click(boardEl, 'e2');
+    expect(chess.state.drawable.shapes).toHaveLength(0);
+  });
+});
+
+describe('drawable.eraseOnClick = true (explicit)', () => {
+  const config: Config = { drawable: { eraseOnClick: true } };
+
+  test('clicking an empty square erases all shapes', () => {
+    const { chess, boardEl } = setup(config);
+    withArrow(chess);
+    click(boardEl, 'd4');
+    expect(chess.state.drawable.shapes).toHaveLength(0);
+  });
+
+  test('clicking an immovable piece erases all shapes', () => {
+    const { chess, boardEl } = setup(config);
+    withArrow(chess);
+    click(boardEl, 'd7');
+    expect(chess.state.drawable.shapes).toHaveLength(0);
+  });
+
+  test('clicking a movable piece erases all shapes', () => {
+    const { chess, boardEl } = setup(config);
+    withArrow(chess);
+    click(boardEl, 'e2');
+    expect(chess.state.drawable.shapes).toHaveLength(0);
+  });
+});
+
+describe('drawable.eraseOnClick = false', () => {
+  const config: Config = { drawable: { eraseOnClick: false } };
+
+  test('clicking an empty square keeps the shapes', () => {
+    const { chess, boardEl } = setup(config);
+    withArrow(chess);
+    click(boardEl, 'd4');
+    expect(chess.state.drawable.shapes).toHaveLength(1);
+  });
+
+  test('clicking an immovable piece keeps the shapes', () => {
+    const { chess, boardEl } = setup(config);
+    withArrow(chess);
+    click(boardEl, 'd7');
+    expect(chess.state.drawable.shapes).toHaveLength(1);
+  });
+
+  test('clicking a movable piece keeps the shapes', () => {
+    const { chess, boardEl } = setup(config);
+    withArrow(chess);
+    click(boardEl, 'e2');
+    expect(chess.state.drawable.shapes).toHaveLength(1);
+  });
+});
