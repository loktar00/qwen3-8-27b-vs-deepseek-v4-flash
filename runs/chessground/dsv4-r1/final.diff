diff --git a/tests/resizeObserver.test.ts b/tests/resizeObserver.test.ts
new file mode 100644
index 0000000..64f2c30
--- /dev/null
+++ b/tests/resizeObserver.test.ts
@@ -0,0 +1,56 @@
+import { Chessground } from '../src/chessground';
+
+// jsdom does not implement ResizeObserver, so track instances manually.
+class ResizeObserverMock {
+  static instances: ResizeObserverMock[] = [];
+  callback: ResizeObserverCallback;
+  observed = new Set<Element>();
+  constructor(callback: ResizeObserverCallback) {
+    this.callback = callback;
+    ResizeObserverMock.instances.push(this);
+  }
+  observe(el: Element): void {
+    this.observed.add(el);
+  }
+  unobserve(el: Element): void {
+    this.observed.delete(el);
+  }
+  disconnect(): void {
+    this.observed.clear();
+  }
+}
+
+beforeEach(() => {
+  window.ResizeObserver = ResizeObserverMock as unknown as typeof ResizeObserver;
+  ResizeObserverMock.instances = [];
+});
+
+const makeWrap = (): HTMLDivElement => {
+  const wrap = document.createElement('div');
+  wrap.style.cssText = 'width:200px;height:200px';
+  document.body.appendChild(wrap);
+  return wrap;
+};
+
+test('destroy disconnects the ResizeObserver', () => {
+  const wrap = makeWrap();
+  const cg = Chessground(wrap, { viewOnly: true });
+  const ro = ResizeObserverMock.instances[0];
+  expect(ro.observed).toContain(wrap);
+  cg.destroy();
+  expect(ro.observed.size).toBe(0);
+  wrap.remove();
+});
+
+test('redraws do not accumulate ResizeObservers', () => {
+  const wrap = makeWrap();
+  const cg = Chessground(wrap, { viewOnly: true });
+  expect(ResizeObserverMock.instances).toHaveLength(1);
+  cg.redrawAll();
+  cg.redrawAll();
+  cg.toggleOrientation();
+  expect(ResizeObserverMock.instances).toHaveLength(1);
+  cg.destroy();
+  expect(ResizeObserverMock.instances[0].observed.size).toBe(0);
+  wrap.remove();
+});
