+import { renderHook, act } from '@testing-library/react';
+import { describe, it, expect } from 'vitest';
+import { usePinnedEditMode } from '../usePinnedEditMode';
+
+const renderEditMode = (pinnedChannels: string[]) => renderHook(() => usePinnedEditMode(pinnedChannels));
+
+describe('usePinnedEditMode', () => {
+    it('starts editing with a draft snapshot of the current order', () => {
+        const { result } = renderEditMode(['a', 'b', 'c']);
+
+        expect(result.current.isEditMode).toBe(false);
+
+        act(() => result.current.startEdit());
+
+        expect(result.current.isEditMode).toBe(true);
+        expect(result.current.draft).toEqual([
+            { channel: 'a', order: 0 },
+            { channel: 'b', order: 1 },
+            { channel: 'c', order: 2 },
+        ]);
+    });
+
+    it('pins an unpinned chat by appending to the end of the draft', () => {
+        const { result } = renderEditMode(['a', 'b']);
+        act(() => result.current.startEdit());
+
+        act(() => result.current.togglePin('c', true));
+
+        expect(result.current.draft).toEqual([
+            { channel: 'a', order: 0 },
+            { channel: 'b', order: 1 },
+            { channel: 'c', order: 2 },
+        ]);
+    });
+
+    it('unpins a chat and renumbers the remaining draft entries', () => {
+        const { result } = renderEditMode(['a', 'b', 'c']);
+        act(() => result.current.startEdit());
+
+        act(() => result.current.togglePin('b', false));
+
+        expect(result.current.draft).toEqual([
+            { channel: 'a', order: 0 },
+            { channel: 'c', order: 1 },
+        ]);
+    });
+
+    it('reorders the draft on drag', () => {
+        const { result } = renderEditMode(['a', 'b', 'c', 'd']);
+        act(() => result.current.startEdit());
+
+        act(() => result.current.reorderPinned('a', 'c'));
+
+        expect(result.current.draft?.map((pin) => pin.channel)).toEqual(['b', 'c', 'a', 'd']);
+        // dense renumbering after the move
+        expect(result.current.draft).toEqual([
+            { channel: 'b', order: 0 },
+            { channel: 'c', order: 1 },
+            { channel: 'a', order: 2 },
+            { channel: 'd', order: 3 },
+        ]);
+    });
+
+    it('save returns the renumbered array, closes edit mode, and drops the draft', () => {
+        const { result } = renderEditMode(['a', 'b']);
+        act(() => result.current.startEdit());
+        act(() => result.current.togglePin('c', true));
+
+        let saved: { channel: string, order: number }[] | undefined;
+        act(() => { saved = result.current.saveEdit(); });
+
+        expect(saved).toEqual([
+            { channel: 'a', order: 0 },
+            { channel: 'b', order: 1 },
+            { channel: 'c', order: 2 },
+        ]);
+        expect(result.current.isEditMode).toBe(false);
+        expect(result.current.draft).toBeNull();
+    });
+
+    it('save does nothing when not editing', () => {
+        const { result } = renderEditMode(['a', 'b']);
+
+        expect(result.current.saveEdit()).toBeUndefined();
+        expect(result.current.isEditMode).toBe(false);
+    });
+
+    it('cancel discards the draft and closes edit mode', () => {
+        const { result } = renderEditMode(['a', 'b', 'c']);
+        act(() => result.current.startEdit());
+        act(() => result.current.togglePin('a', false));
+        act(() => result.current.reorderPinned('b', 'c'));
+
+        act(() => result.current.cancelEdit());
+
+        expect(result.current.isEditMode).toBe(false);
+        expect(result.current.draft).toBeNull();
+    });
+});
