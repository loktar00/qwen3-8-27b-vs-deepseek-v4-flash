diff --git a/tests/observer.test.ts b/tests/observer.test.ts
new file mode 100644
index 0000000..7b10118
--- /dev/null
+++ b/tests/observer.test.ts
@@ -0,0 +1,54 @@
+import { Chessground } from '../src/chessground';
+
+class FakeResizeObserver {
+  static instances: FakeResizeObserver[] = [];
+  callback: ResizeObserverCallback;
+  observed = new Set<Element>();
+  disconnected = false;
+
+  constructor(callback: ResizeObserverCallback) {
+    this.callback = callback;
+    FakeResizeObserver.instances.push(this);
+  }
+  observe(target: Element): void {
+    this.observed.add(target);
+  }
+  unobserve(target: Element): void {
+    this.observed.delete(target);
+  }
+  disconnect(): void {
+    this.disconnected = true;
+    this.observed.clear();
+  }
+}
+
+beforeEach(() => {
+  FakeResizeObserver.instances = [];
+  globalThis.ResizeObserver = FakeResizeObserver as unknown as typeof ResizeObserver;
+});
+
+test('board ResizeObserver is disconnected on destroy and not duplicated on redraw', () => {
+  const wrap = document.createElement('div');
+  wrap.className = 'cg-wrap';
+  document.body.appendChild(wrap);
+
+  const cg = Chessground(wrap);
+  const created = FakeResizeObserver.instances;
+
+  // first render creates exactly one observer on the wrap
+  expect(created).toHaveLength(1);
+  expect(created[0].disconnected).toBe(false);
+  expect(created[0].observed.has(wrap)).toBe(true);
+
+  // redrawAll must not stack observers: previous is disconnected, one fresh one remains
+  cg.redrawAll();
+  expect(created).toHaveLength(2);
+  expect(created[0].disconnected).toBe(true);
+  expect(created[1].disconnected).toBe(false);
+  expect(created[1].observed.has(wrap)).toBe(true);
+
+  // destroy disconnects the active observer
+  cg.destroy();
+  expect(created).toHaveLength(2);
+  expect(created[1].disconnected).toBe(true);
+});
