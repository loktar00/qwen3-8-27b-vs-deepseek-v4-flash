+
+
+    async def test_acquire_nowait_cannot_steal_reserved_token(self) -> None:
+        # Regression test: the token freed by a release is reserved for the
+        # next waiter as soon as it is notified, so a non-blocking acquire
+        # issued before the waiter resumes must raise WouldBlock
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+        acquired = False
+
+        async def b() -> None:
+            nonlocal acquired
+            await limiter.acquire_on_behalf_of("B")
+            acquired = True
+            limiter.release_on_behalf_of("B")
+
+        async with create_task_group() as tg:
+            tg.start_soon(b)
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 1
+
+            # Frees the token and notifies B, which has not resumed yet
+            limiter.release_on_behalf_of("A")
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+            assert limiter.borrowed_tokens == 1
+            assert limiter.available_tokens == 0
+            assert acquired is False
+
+        assert acquired
+        assert limiter.borrowed_tokens == 0
+        assert limiter.available_tokens == 1
+
+    async def test_increase_tokens_reserves_tokens_for_waiters(self) -> None:
+        # Regression test: when total_tokens is raised while tasks are
+        # waiting, the newly available tokens are reserved for the woken
+        # waiters, so a non-blocking acquire cannot steal them
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+        entered = []
+
+        async def worker(name: str) -> None:
+            await limiter.acquire_on_behalf_of(name)
+            entered.append(name)
+            limiter.release_on_behalf_of(name)
+
+        async with create_task_group() as tg:
+            tg.start_soon(worker, "B")
+            tg.start_soon(worker, "C")
+            await wait_all_tasks_blocked()
+            assert limiter.statistics().tasks_waiting == 2
+
+            limiter.total_tokens = 3
+            # B and C have been notified and hold their tokens, so nothing
+            # is available for a non-blocking acquire in this window
+            assert limiter.borrowed_tokens == 3
+            assert limiter.available_tokens == 0
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        limiter.release_on_behalf_of("A")
+        assert entered == ["B", "C"]
+        assert limiter.borrowed_tokens == 0
+        assert limiter.available_tokens == 3
+
+    @pytest.mark.parametrize("anyio_backend", asyncio_params)
+    async def test_cancel_after_release(self) -> None:
+        """
+        Test that a native asyncio cancellation between a release() and the
+        resumption of acquire() does not lose or double-grant the token: the
+        token reserved for the cancelled waiter must be handed to the next
+        task in line.
+
+        """
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+        entered = []
+
+        async def worker(name: str) -> None:
+            await limiter.acquire_on_behalf_of(name)
+            entered.append(name)
+            limiter.release_on_behalf_of(name)
+
+        loop = asyncio.get_running_loop()
+        task1 = loop.create_task(worker("B"), name="task1")
+        await asyncio.sleep(0)
+        task2 = loop.create_task(worker("C"), name="task2")
+        await asyncio.sleep(0)
+
+        # Reserves the token for task1, which is then cancelled before it
+        # resumes; the token must be handed to task2
+        limiter.release_on_behalf_of("A")
+        task1.cancel()
+        await asyncio.wait([task1, task2], timeout=5)
+
+        assert task1.cancelled()
+        assert not task2.cancelled()
+        assert entered == ["C"]
+        assert limiter.borrowed_tokens == 0
+        assert limiter.available_tokens == 1
