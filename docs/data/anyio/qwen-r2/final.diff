diff --git a/tests/test_synchronization.py b/tests/test_synchronization.py
index 3ead3c2..cdeee76 100644
--- a/tests/test_synchronization.py
+++ b/tests/test_synchronization.py
@@ -993,3 +993,64 @@ class TestCapacityLimiter:
         limiter.acquire_on_behalf_of_nowait(borrower1)
         with pytest.raises(WouldBlock):
             limiter.acquire_on_behalf_of_nowait(borrower2)
+
+    async def test_acquire_nowait_race(self) -> None:
+        """
+        Test against a race condition: when a release() hands the just-freed token to
+        a woken waiter, a non-blocking acquire issued before the waiter resumes must
+        raise WouldBlock instead of over-granting the limiter.
+
+        """
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+        async with create_task_group() as tg:
+            tg.start_soon(limiter.acquire_on_behalf_of, "B")
+            await wait_all_tasks_blocked()
+            limiter.release_on_behalf_of("A")
+            assert limiter.available_tokens == 0
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        assert limiter.borrowed_tokens == 1
+        assert limiter.available_tokens == 0
+        assert limiter.statistics().tasks_waiting == 0
+
+    async def test_increase_tokens_nowait_race(self) -> None:
+        """
+        Test against a race condition: when increasing total_tokens wakes waiting
+        tasks, the granted tokens must be reserved for the woken tasks, so a
+        non-blocking acquire issued before they resume must raise WouldBlock, and
+        tasks that were not woken must remain in the wait queue.
+
+        """
+        limiter = CapacityLimiter(1)
+
+        async def borrow(name: str) -> None:
+            await limiter.acquire_on_behalf_of(name)
+
+        limiter.acquire_on_behalf_of_nowait("A")
+        async with create_task_group() as tg:
+            tg.start_soon(borrow, "B")
+            tg.start_soon(borrow, "C")
+            await wait_all_tasks_blocked()
+            limiter.total_tokens = 2
+            # B's granted token is reserved at notify time; C was not woken
+            assert limiter.borrowed_tokens == 2
+            assert limiter.available_tokens == 0
+            assert limiter.statistics().tasks_waiting == 1
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+            limiter.release_on_behalf_of("A")
+            # The freed token is handed to C, so none is left for a non-blocking
+            # acquire
+            assert limiter.borrowed_tokens == 2
+            assert limiter.available_tokens == 0
+            assert limiter.statistics().tasks_waiting == 0
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        limiter.release_on_behalf_of("B")
+        limiter.release_on_behalf_of("C")
+        assert limiter.borrowed_tokens == 0
+        assert limiter.available_tokens == 2
