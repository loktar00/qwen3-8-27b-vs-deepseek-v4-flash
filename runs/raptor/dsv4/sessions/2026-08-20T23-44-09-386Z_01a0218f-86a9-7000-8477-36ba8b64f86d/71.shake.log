// glb.js — Reader for Raptor's .GLB archive format (GLBAPI.C).
//
// File layout:
//   [0..27]  header KEYFILE, ENCRYPTED with key "32768GLB", SEED 0x19
//             (its `offset` field holds the item count)
//   [28..]    item descriptor table: `count` KEYFILE entries, ENCRYPTED
//             (per-entry, independent cipher state)
//   each item  { DWORD opt; DWORD offset; DWORD filesize; CHAR name[16]; }
//   optional per-item payload encryption (opt == GLB_ENCODED)
//
// The payload encryption is the same chained cipher as the headers.

const SEED = 0x19;
const SERIAL = '32768GLB';
const KLEN = SERIAL.length;
const KIDX0 = SEED % KLEN;          // 1 -> key[1] = '2'

// In-place decrypt of a Uint8Array/ArrayBuffer view (returns a new copy).
export function decrypt(buf) {
  const out = new Uint8Array(buf.byteLength ?? buf.length);
  out.set(buf instanceof Uint8Array ? buf : new Uint8Array(buf));
  let prev = SERIAL.charCodeAt(KIDX0);
  let kidx = KIDX0;
  for (let i = 0; i < out.length; i++) {
    const byte = out[i];
    let d = (byte - SERIAL.charCodeAt(kidx) - prev) % 256;
    if (d < 0) d += 256;
    out[i] = d;
    prev = byte;
    kidx = (kidx + 1) % KLEN;
  }
  return out;
}

const dv = (b, o) => new DataView(b.buffer, b.byteOffset + o, b.byteLength - o);

export class GLBFile {
  // `data` is an ArrayBuffer of the whole .GLB file.
  constructor(data) {
    this.data = data;
    const head = decrypt(new Uint8Array(data, 0, 28));
    this.count = dv(head, 4).getUint32(0, true);
    this.items = [];
    const idt = new Uint8Array(data);
    for (let i = 0; i < this.count; i++) {
      const e = decrypt(idt.subarray(28 + i * 28, 28 + (i + 1) * 28));
      const v = dv(e, 0);
      this.items.push({
        index: i,
        opt: v.getUint32(0, true),
        offset: v.getUint32(4, true),
        filesize: v.getUint32(8, true),
        name: String.fromCharCode(...e.subarray(12, 28)).split('\0')[0],
      });
    }
    this._byName = new Map();
    for (const it of this.items) this._byName.set(it.name, it);
  }

  itemSize(nameOrIndex) {
    const it = typeof nameOrIndex === 'number' ? this.items[nameOrIndex] : this._byName.get(nameOrIndex);
    return it ? it.filesize : 0;
  }

  // Return a Uint8Array view of the decoded item payload.
  raw(nameOrIndex) {
    const it = typeof nameOrIndex === 'number' ? this.items[nameOrIndex] : this._byName.get(nameOrIndex);
    if (!it) throw new Error('GLB item not found: ' + nameOrIndex);
    const raw = new Uint8Array(this.data, it.offset, it.filesize);
    return it.opt === 1 ? decrypt(raw) : raw.slice();
  }

  find(nameOrIndex) {
    const it = typeof nameOrIndex === 'number' ? this.items[nameOrIndex] : this._byName.get(nameOrIndex);
    return it;
  }
}

export async function loadGLB(path) {
  // Node: read directly from disk. Browser: fetch.
  if (typeof process !== 'undefined' && process.versions && process.versions.node) {
    const fs = await import('node:fs');
    let p = path;
    if (p.startsWith('file://')) p = new URL(p).pathname.replace(/^\/([A-Za-z]:)/, '$1');
    const data = fs.readFileSync(p);
    return new GLBFile(data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength));
  }
  const res = await fetch(path);
  if (!res.ok) throw new Error('GLB fetch failed: ' + path + ' (' + res.status + ')');
  const ab = await res.arrayBuffer();
  return new GLBFile(ab);
}

