diff --git a/tests/resize-observer.test.ts b/tests/resize-observer.test.ts
new file mode 100644
index 0000000..f6e2c5d
--- /dev/null
+++ b/tests/resize-observer.test.ts
@@ -0,0 +1,86 @@
+import { Chessground } from '../src/chessground';
+
+// jsdom has no ResizeObserver, and chessground only creates one when
+// 'ResizeObserver' in window holds at bind time, so install a tracking
+// mock before any board is created.
+class MockResizeObserver {
+  static instances: MockResizeObserver[] = [];
+
+  observed = new Set<Element>();
+  disconnected = false;
+
+  constructor(_callback: (entries: unknown[], observer: unknown) => void) {
+    MockResizeObserver.instances.push(this);
+  }
+
+  observe(target: Element) {
+    if (!this.disconnected) this.observed.add(target);
+  }
+
+  unobserve(target: Element) {
+    this.observed.delete(target);
+  }
+
+  disconnect() {
+    this.disconnected = true;
+    this.observed.clear();
+  }
+}
+
+const liveObservers = () => MockResizeObserver.instances.filter(o => !o.disconnected);
+
+beforeAll(() => {
+  (window as unknown as { ResizeObserver: unknown }).ResizeObserver = MockResizeObserver;
+});
+
+afterEach(() => {
+  MockResizeObserver.instances.length = 0;
+  document.body.innerHTML = '';
+});
+
+test('destroy disconnects the resize observer', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const cg = Chessground(wrap, { viewOnly: true });
+  expect(liveObservers()).toHaveLength(1);
+  cg.destroy();
+  expect(liveObservers()).toHaveLength(0);
+});
+
+test('destroy disconnects the resize observer of a playable board', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const cg = Chessground(wrap);
+  expect(liveObservers()).toHaveLength(1);
+  cg.destroy();
+  expect(liveObservers()).toHaveLength(0);
+});
+
+test('redrawAll does not accumulate resize observers', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const cg = Chessground(wrap, { viewOnly: true });
+  cg.redrawAll();
+  cg.redrawAll();
+  // two redraws created three observers in total, but only the last one
+  // may still be observing
+  expect(MockResizeObserver.instances).toHaveLength(3);
+  expect(liveObservers()).toHaveLength(1);
+  cg.destroy();
+  expect(liveObservers()).toHaveLength(0);
+});
+
+test('destroying boards releases their resize observers', () => {
+  const wraps = [0, 1, 2].map(() => {
+    const w = document.createElement('div');
+    document.body.appendChild(w);
+    return w;
+  });
+  const cgs = wraps.map(w => Chessground(w, { viewOnly: true }));
+  expect(liveObservers()).toHaveLength(3);
+  cgs[0].destroy();
+  wraps[0].remove();
+  expect(liveObservers()).toHaveLength(2);
+  cgs.forEach(c => c.destroy());
+  expect(liveObservers()).toHaveLength(0);
+});
