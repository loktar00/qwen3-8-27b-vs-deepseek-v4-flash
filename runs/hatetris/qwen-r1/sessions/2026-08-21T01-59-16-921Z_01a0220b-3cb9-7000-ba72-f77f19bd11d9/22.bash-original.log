+  it('lets you take over when a replay ends without the game being over', async () => {
+    const warn = sinon.stub(console, 'warn')
+
+    const game = renderGame()
+
+    // Replay is an incomplete game
+    const prompt = sinon.stub(window, 'prompt')
+    prompt.returns('D')
+    await user.click(screen.getByTestId('replay-button'))
+    assert.deepEqual(prompt.getCalls().map(call => call.args), [
+      ['Paste replay string...']
+    ])
+    prompt.restore()
+
+    // Play beyond the end of the supplied replay
+    await advanceReplaySteps(10)
+
+    // The replay is over but the game is not, so the game
+    // should be handed back to the player
+    assert.equal(screen.queryAllByTestId('down').length, 1)
+
+    // and the player's inputs should be accepted
+    await user.keyboard('{Left}')
+    assert.equal(warn.getCalls().length, 0)
+
+    game.unmount()
+    warn.restore()
+  })
+
+  it('ends in the game over screen when a replay ends exactly at game over', async () => {
+    const game = renderGame()
+
+    // Replay ends the game on its last move
