+    await userEvent.click(screen.getByRole('button', { name: 'bump 0' }));
+    await userEvent.click(screen.getByRole('button', { name: 'bump 1' }));
+
+    expect(triggerRef).toHaveBeenCalledTimes(1);
+  });
+});
