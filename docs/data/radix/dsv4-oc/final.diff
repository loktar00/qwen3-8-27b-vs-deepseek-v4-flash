@@ -0,0 +1,37 @@
+import * as React from 'react';
+import { cleanup, render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { DropdownMenu, DropdownMenuTrigger } from './dropdown-menu';
+import { afterEach, describe, it, expect, vi } from 'vitest';
+
+describe('DropdownMenuTrigger unstable composed ref (React 19)', () => {
+  afterEach(cleanup);
+
+  it('does not throw "Maximum update depth exceeded" when a function ref schedules state', async () => {
+    const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
+
+    function Repro() {
+      const [text, setText] = React.useState('');
+      const ref = React.useCallback((_node: HTMLButtonElement | null) => {
+        setText((t) => t + '!');
+      }, []);
+
+      return (
+        <div>
+          <input value={text} onChange={(e) => setText(e.target.value)} />
+          <DropdownMenu>
+            <DropdownMenuTrigger ref={ref}>open</DropdownMenuTrigger>
+          </DropdownMenu>
+        </div>
+      );
+    }
+
+    render(<Repro />);
+    await userEvent.type(screen.getByRole('textbox'), 'a');
+
+    expect(console.error).not.toHaveBeenCalledWith(
+      expect.stringContaining('Maximum update depth exceeded'),
+    );
+    errorSpy.mockRestore();
+  });
+});
