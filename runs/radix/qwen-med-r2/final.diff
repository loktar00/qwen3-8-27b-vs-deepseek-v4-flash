@@ -0,0 +1,58 @@
+import * as React from 'react';
+import { act, cleanup, render } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import * as DropdownMenu from './dropdown-menu';
+
+// Regression tests for https://github.com/radix-ui/primitives/issues/3963
+// `DropdownMenu.Trigger` created a new composed ref callback on every render
+// (`ref={composeRefs(forwardedRef, context.triggerRef)}`), which made React
+// detach and re-attach the ref on every render. When attaching the ref
+// triggered a render, this looped until React hit its update depth limit.
+describe('DropdownMenu ref stability', () => {
+  afterEach(cleanup);
+
+  it('does not cause an infinite render loop when attaching the trigger ref triggers a render', () => {
+    let renderCount = 0;
+
+    function App() {
+      renderCount++;
+      const [, forceRender] = React.useReducer((c) => c + 1, 0);
+      const ref = React.useCallback((node: HTMLButtonElement | null) => {
+        if (node) forceRender();
+      }, []);
+
+      return (
+        <DropdownMenu.Root>
+          <DropdownMenu.Trigger ref={ref}>Open</DropdownMenu.Trigger>
+        </DropdownMenu.Root>
+      );
+    }
+
+    expect(() => render(<App />)).not.toThrow();
+    expect(renderCount).toBeLessThan(25);
+  });
+
+  it('does not re-invoke the trigger ref callback across parent re-renders', () => {
+    const refSpy = vi.fn();
+    let bump!: () => void;
+
+    function App() {
+      const [, forceRender] = React.useReducer((c) => c + 1, 0);
+      bump = forceRender;
+      return (
+        <DropdownMenu.Root>
+          <DropdownMenu.Trigger ref={refSpy}>Open</DropdownMenu.Trigger>
+        </DropdownMenu.Root>
+      );
+    }
+
+    render(<App />);
+    act(() => bump());
+    act(() => bump());
+
+    // The composed ref attached to the trigger must be stable, so the
+    // user's ref callback fires exactly once (on mount) with the DOM node.
+    expect(refSpy).toHaveBeenCalledTimes(1);
+    expect(refSpy).toHaveBeenLastCalledWith(expect.any(HTMLButtonElement));
+  });
+});
