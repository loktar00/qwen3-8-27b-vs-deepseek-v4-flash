diff --git a/tests/resize-observer.test.ts b/tests/resize-observer.test.ts
new file mode 100644
index 0000000..7233821
--- /dev/null
+++ b/tests/resize-observer.test.ts
@@ -0,0 +1,66 @@
+import { afterEach, beforeEach, expect, test } from 'vitest';
+import { Chessground } from '../src/chessground';
+
+// jsdom does not implement ResizeObserver. Provide a recording polyfill so
+// we can assert on observer lifecycle (observe/disconnect).
+class FakeResizeObserver {
+  static instances: FakeResizeObserver[] = [];
+
+  readonly observed: Element[] = [];
+  disconnected = false;
+
+  constructor(private readonly _callback: (entries: unknown[], observer: FakeResizeObserver) => void) {
+    FakeResizeObserver.instances.push(this);
+  }
+
+  observe(target: Element): void {
+    this.observed.push(target);
+  }
+
+  unobserve(): void {}
+
+  disconnect(): void {
+    this.disconnected = true;
+  }
+}
+
+beforeEach(() => {
+  FakeResizeObserver.instances = [];
+  (window as unknown as Record<string, unknown>).ResizeObserver = FakeResizeObserver;
+});
+
+afterEach(() => {
+  delete (window as unknown as Record<string, unknown>).ResizeObserver;
+});
+
+test('destroy disconnects the ResizeObserver', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+
+  const cg = Chessground(wrap, { viewOnly: true });
+  expect(FakeResizeObserver.instances).toHaveLength(1);
+  expect(FakeResizeObserver.instances[0].disconnected).toBe(false);
+
+  cg.destroy();
+  expect(FakeResizeObserver.instances[0].disconnected).toBe(true);
+});
+
+test('redrawAll disconnects the previous ResizeObserver', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+
+  const cg = Chessground(wrap, { viewOnly: true });
+  cg.redrawAll();
+  cg.redrawAll();
+  expect(FakeResizeObserver.instances).toHaveLength(3);
+
+  // the old observers (observing detached wraps) must be disconnected
+  expect(FakeResizeObserver.instances[0].disconnected).toBe(true);
+  expect(FakeResizeObserver.instances[1].disconnected).toBe(true);
+  // only the current wrap is observed by the newest observer
+  expect(FakeResizeObserver.instances[2].disconnected).toBe(false);
+  expect(FakeResizeObserver.instances[2].observed).toEqual([wrap]);
+
+  cg.destroy();
+  expect(FakeResizeObserver.instances[2].disconnected).toBe(true);
+});
