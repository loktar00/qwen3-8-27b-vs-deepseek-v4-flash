+import { start as dragStart } from '../src/drag';
+import { type DrawShape } from '../src/draw';
+import { defaults, type State } from '../src/state';
+import type * as cg from '../src/types';
+import * as util from '../src/util';
+
+const SQUARE = 64;
+
+const initialShapes: DrawShape[] = [
+  { orig: 'a1', dest: 'b2', brush: 'arrow' },
+  { orig: 'c3', brush: 'circle' },
+];
+
+const makeState = (drawable: Record<string, unknown> = {}): State => {
+  const state: State = {
+    ...defaults(),
+    trustAllEvents: true,
+    selectable: { enabled: false },
+    draggable: { enabled: false },
+    dom: {
+      elements: {
+        board: document.createElement('div'),
+        wrap: document.createElement('div'),
+        container: document.createElement('div'),
+      },
+      bounds: util.memo(() => new DOMRect(0, 0, SQUARE * 8, SQUARE * 8)),
+      redraw: () => undefined,
+      redrawNow: () => undefined,
+    },
+  };
+  Object.assign(state.drawable, drawable);
+  state.drawable.shapes = [...initialShapes];
+  return state;
+};
+
+// simulate a left click on the given square; only the erase-on-click decision is exercised
+const click = (state: State, key: cg.Key): void => {
+  const [file, rank] = util.key2pos(key);
+  dragStart(state, {
+    clientX: file * SQUARE + SQUARE / 2,
+    clientY: (7 - rank) * SQUARE + SQUARE / 2,
+    cancelable: true,
+    preventDefault: () => undefined,
+  } as cg.MouchEvent);
+};
+
+test('clicking an empty square clears drawn shapes by default', () => {
+  const state = makeState();
+  click(state, 'e3');
+  expect(state.drawable.shapes).toEqual([]);
+});
+
+test('clicking an opponent piece clears drawn shapes by default', () => {
+  const state = makeState();
+  click(state, 'e7');
+  expect(state.drawable.shapes).toEqual([]);
+});
+
+test('clicking a movable piece clears drawn shapes by default', () => {
+  const state = makeState();
+  click(state, 'e2');
+  expect(state.drawable.shapes).toEqual([]);
+});
+
+test('eraseOnClick: false prevents clearing shapes on empty square click', () => {
+  const state = makeState({ eraseOnClick: false });
+  click(state, 'e3');
+  expect(state.drawable.shapes).toEqual(initialShapes);
+});
+
+test('eraseOnClick: false prevents clearing shapes on opponent piece click', () => {
+  const state = makeState({ eraseOnClick: false });
+  click(state, 'e7');
+  expect(state.drawable.shapes).toEqual(initialShapes);
+});
+
+test('eraseOnClick: false prevents clearing shapes on movable piece click', () => {
+  const state = makeState({ eraseOnClick: false });
+  click(state, 'e2');
+  expect(state.drawable.shapes).toEqual(initialShapes);
+});
+
+test('eraseOnClick: false wins over eraseOnMovablePieceClick: true', () => {
+  const state = makeState({ eraseOnClick: false, eraseOnMovablePieceClick: true });
+  click(state, 'e2');
+  expect(state.drawable.shapes).toEqual(initialShapes);
+});
+
+test('eraseOnClick: true still clears shapes on click', () => {
+  const empty = makeState({ eraseOnClick: true });
+  click(empty, 'e3');
+  expect(empty.drawable.shapes).toEqual([]);
+
+  const opponent = makeState({ eraseOnClick: true });
+  click(opponent, 'e7');
+  expect(opponent.drawable.shapes).toEqual([]);
+
+  const movable = makeState({ eraseOnClick: true, eraseOnMovablePieceClick: true });
+  click(movable, 'e2');
+  expect(movable.drawable.shapes).toEqual([]);
+});
+
+test('eraseOnMovablePieceClick: false only prevents clearing on movable piece click', () => {
+  const movable = makeState({ eraseOnMovablePieceClick: false });
+  click(movable, 'e2');
+  expect(movable.drawable.shapes).toEqual(initialShapes);
+
+  const empty = makeState({ eraseOnMovablePieceClick: false });
+  click(empty, 'e3');
+  expect(empty.drawable.shapes).toEqual([]);
+});
