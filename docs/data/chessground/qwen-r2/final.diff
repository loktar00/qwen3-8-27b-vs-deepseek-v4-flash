diff --git a/tests/resize-observer.test.ts b/tests/resize-observer.test.ts
new file mode 100644
index 0000000..262ec1e
--- /dev/null
+++ b/tests/resize-observer.test.ts
@@ -0,0 +1,65 @@
+import { vi } from 'vitest';
+import { Chessground } from '../src/chessground';
+
+interface MockRO {
+  connected: boolean;
+  observed: Element[];
+}
+
+let observers: MockRO[] = [];
+
+class MockResizeObserver {
+  connected = true;
+  observed: Element[] = [];
+
+  constructor(_callback: ResizeObserverCallback) {
+    observers.push(this);
+  }
+
+  observe(target: Element): void {
+    this.observed.push(target);
+  }
+
+  unobserve(target: Element): void {
+    this.observed = this.observed.filter(t => t !== target);
+  }
+
+  disconnect(): void {
+    this.connected = false;
+  }
+}
+
+const live = (): MockRO[] => observers.filter(o => o.connected);
+const observedBy = (obs: MockRO[]): Element[] => obs.flatMap(o => o.observed);
+
+beforeEach(() => {
+  observers = [];
+  vi.stubGlobal('ResizeObserver', MockResizeObserver);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+test('destroy disconnects the ResizeObserver', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const cg = Chessground(wrap, { viewOnly: true });
+  expect(observers).toHaveLength(1);
+  expect(observedBy(observers)).toContain(wrap);
+  cg.destroy();
+  expect(live()).toHaveLength(0);
+});
+
+test('redrawAll disconnects previous ResizeObservers', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const cg = Chessground(wrap, { viewOnly: true });
+  cg.redrawAll();
+  cg.redrawAll();
+  expect(observers).toHaveLength(3);
+  // only the observer on the current wrap may stay connected
+  expect(live()).toHaveLength(1);
+  expect(live()[0].observed).toEqual([cg.state.dom.elements.wrap]);
+});
+
