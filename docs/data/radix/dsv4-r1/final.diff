+++ b/packages/react/slot/src/slot.test.tsx
@@ -339,6 +339,65 @@ describe('Slot prop and ref merging (single element child)', () => {
     expect(slotRef).toHaveBeenCalledWith(button);
     expect(childRef).toHaveBeenCalledWith(button);
   });
+
+  // Guard: without a forwarded ref, `Slot` must pass the child's own ref through
+  // untouched (it must NOT route it through a composed ref).
+  it('passes the child ref through directly when no Slot ref is provided', () => {
+    const childRef = vi.fn();
+    render(
+      <Slot>
+        <button ref={childRef} type="button">
+          hi
+        </button>
+      </Slot>,
+    );
+
+    const button = screen.getByRole('button');
+    expect(childRef).toHaveBeenCalledWith(button);
+    // detaches on unmount, proving it's the child's raw ref, not a composed one
+    cleanup();
+    expect(childRef).toHaveBeenCalledTimes(2);
+    expect(childRef.mock.lastCall?.[0]).toBeNull();
+  });
+});
+
+describe('Slot with a stateful ref (React 19 stable identity)', () => {
+  afterEach(cleanup);
+
+  // Regression guard for https://github.com/radix-ui/primitives/issues/3799
+  // "Maximum update depth exceeded". In React 19 a callback ref that returns a
+  // cleanup function (or the result of a state setter) is torn down and
+  // re-attached whenever its identity changes. `Slot` previously composed a fresh
+  // ref on every render, so a ref callback that triggers a state update caused an
+  // infinite loop. The composed ref must keep a stable identity while still
+  // reading the latest refs.
+  it('does not infinitely re-render when a composed ref triggers state updates', () => {
+    let renderCount = 0;
+    let attached: HTMLButtonElement | null = null;
+
+    function App() {
+      const [, setTick] = React.useState(0);
+      renderCount += 1;
+
+      const ref = React.useCallback((node: HTMLButtonElement | null) => {
+        attached = node;
+        if (node) setTick((t) => t + 1);
+      }, []);
+
+      return (
+        <Slot ref={ref}>
+          <button type="button">hi</button>
+        </Slot>
+      );
+    }
+
+    render(<App />);
+
+    expect(attached).toBe(screen.getByRole('button'));
+    // Without the stable-identity fix this renders until React throws
+    // "Maximum update depth exceeded"; with it, the ref fires once and stops.
+    expect(renderCount).toBeLessThanOrEqual(3);
+  });
 });
 
