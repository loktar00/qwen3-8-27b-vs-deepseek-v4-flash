diff --git a/apps/called-chat/src/views/Community/Chat/ContactList/usePinnedEditMode.ts b/apps/called-chat/src/views/Community/Chat/ContactList/usePinnedEditMode.ts
new file mode 100644
index 000000000..dfe3ade09
--- /dev/null
+++ b/apps/called-chat/src/views/Community/Chat/ContactList/usePinnedEditMode.ts
@@ -0,0 +1,64 @@
+import { useState, useCallback } from 'react';
+import type { PinnedChannel } from 'called-api/src/openApi/calledApiSchemas';
+import { addPinnedChannel, movePinnedChannel, removePinnedChannel, renumberPinnedChannels } from '@/utils/pinnedChannel';
+
+/**
+ * Owns the "Edit" mode for the pinned chat section: the working draft, toggling
+ * pins, drag reordering, and Save/Cancel.
+ *
+ * - startEdit snapshots the current pinned order into a draft.
+ * - togglePin / reorderPinned mutate only the draft — nothing touches the server,
+ *   so Cancel is free.
+ * - saveEdit returns the fully renumbered array for the caller to PATCH in one
+ *   request, then closes edit mode. Cancel just drops the draft.
+ */
+export const usePinnedEditMode = (pinnedChannels: string[]) => {
+    const [isEditMode, setIsEditMode] = useState(false);
+    const [draft, setDraft] = useState<PinnedChannel[] | null>(null);
+
+    const startEdit = useCallback(() => {
+        setIsEditMode(true);
+        setDraft(pinnedChannels.map((url, index) => ({ channel: url, order: index })));
+    }, [pinnedChannels]);
+
+    const cancelEdit = useCallback(() => {
+        setIsEditMode(false);
+        setDraft(null);
+    }, []);
+
+    const togglePin = useCallback((url: string, pin: boolean) => {
+        setDraft((prev) => {
+            if (!prev) {
+                return prev;
+            }
+            return pin ? addPinnedChannel(prev, url) : removePinnedChannel(prev, url);
+        });
+    }, []);
+
+    const reorderPinned = useCallback((activeUrl: string, overUrl: string) => {
+        setDraft((prev) => (prev ? movePinnedChannel(prev, activeUrl, overUrl) : prev));
+    }, []);
+
+    const saveEdit = useCallback(() => {
+        if (!draft) {
+            return undefined;
+        }
+        const renumbered = renumberPinnedChannels(draft);
+        setIsEditMode(false);
+        setDraft(null);
+        return renumbered;
+    }, [draft]);
+
+    return {
+        isEditMode,
+        draft,
+        // Channel urls in draft order (or [] outside edit mode) — what the list
+        // should render as pinned while editing.
+        draftUrls: draft?.map((pin) => pin.channel) ?? [],
+        startEdit,
+        cancelEdit,
+        togglePin,
+        reorderPinned,
+        saveEdit,
+    };
+};
