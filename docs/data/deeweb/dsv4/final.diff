+import { describe, it, expect } from 'vitest';
+import type { PinnedChannel } from 'called-api/src/openApi/calledApiSchemas';
+import { addPinnedChannel, movePinnedChannel, removePinnedChannel, renumberPinnedChannels } from '../pinnedChannel';
+
+const pins = (urls: string[], orders: number[] = urls.map((_, i) => i)): PinnedChannel[] =>
+    urls.map((url, i) => ({ channel: url, order: orders[i] }));
+
+describe('pinnedChannel ordering helpers', () => {
+    describe('renumberPinnedChannels', () => {
+        it('reassigns order = index, fixing gaps left by unpinning', () => {
+            // Unpinning A and C from orders 0..3 leaves D at 3 — a gap.
+            const result = renumberPinnedChannels(pins(['B', 'D'], [1, 3]));
+            expect(result).toEqual(pins(['B', 'D']));
+        });
+
+        it('reassigns order = index, fixing collisions left by pinning', () => {
+            // Pinning twice without renumbering gives two pins with order 2.
+            const result = renumberPinnedChannels(pins(['C', 'E'], [2, 2]));
+            expect(result).toEqual(pins(['C', 'E']));
+        });
+
+        it('keeps an already dense array unchanged', () => {
+            const input = pins(['A', 'B', 'C']);
+            expect(renumberPinnedChannels(input)).toEqual(input);
+        });
+
+        it('handles an empty array', () => {
+            expect(renumberPinnedChannels([])).toEqual([]);
+        });
+    });
+
+    describe('addPinnedChannel', () => {
+        it('appends a new pin to the end and renumbers', () => {
+            // D was pinned first but left at order 3 after unpins; a new pin
+            // must sort below it, not collide with orders 1 and 2.
+            const result = addPinnedChannel(pins(['D'], [3]), 'E');
+            expect(result).toEqual(pins(['D', 'E']));
+        });
+
+        it('appends to an empty list as order 0', () => {
+            expect(addPinnedChannel([], 'A')).toEqual([{ channel: 'A', order: 0 }]);
+        });
+    });
+
+    describe('removePinnedChannel', () => {
+        it('removes the pin and closes the gap', () => {
+            expect(removePinnedChannel(pins(['A', 'B', 'C', 'D']), 'B'))
+                .toEqual(pins(['A', 'C', 'D']));
+        });
+
+        it('is a no-op when the channel is not pinned', () => {
+            const input = pins(['A', 'B']);
+            expect(removePinnedChannel(input, 'Z')).toEqual(input);
+        });
+    });
+
+    describe('movePinnedChannel', () => {
+        it('moves a pin down and renumbers', () => {
+            // A,B,C,D -> drag A onto C => B,C,A,D
+            expect(movePinnedChannel(pins(['A', 'B', 'C', 'D']), 'A', 'C'))
+                .toEqual(pins(['B', 'C', 'A', 'D']));
+        });
+
+        it('moves a pin up and renumbers', () => {
+            expect(movePinnedChannel(pins(['A', 'B', 'C', 'D']), 'C', 'B'))
+                .toEqual(pins(['A', 'C', 'B', 'D']));
+        });
+
+        it('is a no-op when dropped on itself', () => {
+            const input = pins(['A', 'B', 'C']);
+            expect(movePinnedChannel(input, 'B', 'B')).toEqual(input);
+        });
+
+        it('is a no-op for unknown urls', () => {
+            const input = pins(['A', 'B']);
+            expect(movePinnedChannel(input, 'Z', 'A')).toEqual(input);
+            expect(movePinnedChannel(input, 'A', 'Z')).toEqual(input);
+        });
+    });
+});
