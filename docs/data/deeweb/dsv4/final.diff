+import type { PinnedChannel } from 'called-api/src/openApi/calledApiSchemas';
+
+// The backend stores an explicit order per pinned channel and replaces the whole
+// array on PATCH /v1/account/settings. Renumbering densely (order === index)
+// on every write keeps the sequence gapless and collision-free so pins render in
+// the stored order. A new pin must always land below every existing one, which
+// appending does.
+export const renumberPinnedChannels = (pins: PinnedChannel[]): PinnedChannel[] =>
+    pins.map((pin, index) => ({ channel: pin.channel, order: index }));
+
+// Appends a pin to the end and renumbers. Pinning via the menu (the first
+// pin, or a later one) is the only entry point that adds — edit mode reuses it
+// too — so "add to end" is always correct.
+export const addPinnedChannel = (pins: PinnedChannel[], channelUrl: string): PinnedChannel[] =>
+    renumberPinnedChannels([...pins, { channel: channelUrl, order: pins.length }]);
+
+export const removePinnedChannel = (pins: PinnedChannel[], channelUrl: string): PinnedChannel[] =>
+    renumberPinnedChannels(pins.filter((pin) => pin.channel !== channelUrl));
+
+// Drag reorder: move the active pin into the over pin's slot, then renumber.
+export const movePinnedChannel = (pins: PinnedChannel[], activeUrl: string, overUrl: string): PinnedChannel[] => {
+    const from = pins.findIndex((pin) => pin.channel === activeUrl);
+    const to = pins.findIndex((pin) => pin.channel === overUrl);
+    if (from < 0 || to < 0) {
+        return pins;
+    }
+
+    const reordered = [...pins];
+    const [active] = reordered.splice(from, 1);
+    reordered.splice(to, 0, active);
+
+    return renumberPinnedChannels(reordered);
+};
