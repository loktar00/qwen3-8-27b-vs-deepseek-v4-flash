+    await userEvent.type(screen.getByRole('textbox', { name: 'type here' }), 'foo');
+    expect(refSpy).toHaveBeenCalledTimes(1);
+    expect(screen.getByTestId('size')).toHaveTextContent('0x0');
+  });
 });
 
