diff --git a/tests/test_synchronization.py b/tests/test_synchronization.py
index 3ead3c2..0ad235d 100644
--- a/tests/test_synchronization.py
+++ b/tests/test_synchronization.py
@@ -993,3 +993,51 @@ class TestCapacityLimiter:
         limiter.acquire_on_behalf_of_nowait(borrower1)
         with pytest.raises(WouldBlock):
             limiter.acquire_on_behalf_of_nowait(borrower2)
+
+    async def test_released_token_reserved_for_woken_waiter(self) -> None:
+        """A freed token is handed to the woken waiter, so a nowait acquire must
+        not slip in before the waiter resumes (regression test for over-granting)."""
+
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async def waiter() -> None:
+            await limiter.acquire_on_behalf_of("B")
+
+        async with create_task_group() as tg:
+            tg.start_soon(waiter)
+            while limiter.statistics().tasks_waiting != 1:
+                await checkpoint()
+
+            # The only token is now reserved for the woken waiter
+            limiter.release_on_behalf_of("A")
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        assert limiter.borrowed_tokens <= limiter.total_tokens
+        assert limiter.borrowed_tokens == 1
+        assert limiter.available_tokens == 0
+
+    async def test_increase_tokens_reserves_for_woken_waiter(self) -> None:
+        """Raising total_tokens hands the added tokens to the woken waiters, so a
+        nowait acquire must not slip in before they resume."""
+
+        limiter = CapacityLimiter(1)
+        limiter.acquire_on_behalf_of_nowait("A")
+
+        async def waiter() -> None:
+            await limiter.acquire_on_behalf_of("B")
+
+        async with create_task_group() as tg:
+            tg.start_soon(waiter)
+            while limiter.statistics().tasks_waiting != 1:
+                await checkpoint()
+
+            # The newly added token is now reserved for the woken waiter
+            limiter.total_tokens = 2
+            with pytest.raises(WouldBlock):
+                limiter.acquire_on_behalf_of_nowait("X")
+
+        assert limiter.borrowed_tokens <= limiter.total_tokens
+        assert limiter.borrowed_tokens == 2
+        assert limiter.available_tokens == 0
