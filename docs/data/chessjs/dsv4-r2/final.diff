+test('moves - single square - pawn on last rank', () => {
+  const chess = new Chess()
+  chess.clear()
+  chess.put({ type: PAWN, color: WHITE }, 'h8')
+
+  expect(chess.moves({ square: 'h8' })).toEqual([])
+  expect(chess.moves({ square: 'h8', verbose: true })).toEqual([])
+})
+
+test('moves - single square - black pawn on first rank', () => {
+  const chess = new Chess()
+  chess.clear()
+  chess.put({ type: PAWN, color: BLACK }, 'a1')
+  chess.setTurn(BLACK)
+
+  expect(chess.moves({ square: 'a1' })).toEqual([])
+  expect(chess.moves({ square: 'a1', verbose: true })).toEqual([])
+})
+
+test('moves - single square - promotion on 7th rank (both colors)', () => {
+  // the off-board pawn push guard must not affect promotion generation from the
+  // 7th rank (rank 2 for black); edge files included
+  const cases: [Chess, Square, string][] = [
+    [new Chess('k7/7P/8/8/8/8/8/7K w - - 0 1'), 'h7', 'h8=N h8=B h8=R+ h8=Q+'],
+    [new Chess('7k/P7/8/8/8/8/8/7K w - - 0 1'), 'a7', 'a8=N a8=B a8=R+ a8=Q+'],
+    [new Chess('8/k7/8/8/8/8/7p/K7 b - - 0 1'), 'h2', 'h1=N h1=B h1=R+ h1=Q+'],
+    [new Chess('7K/8/k7/8/8/8/p7/8 b - - 0 1'), 'a2', 'a1=N a1=B+ a1=R a1=Q+'],
+  ]
+
+  for (const [chess, square, expected] of cases) {
+    expect(chess.moves({ square })).to.have.members(split(expected))
+
+    const verbose = chess.moves({ square, verbose: true })
+    expect(verbose.length).toEqual(4)
+    expect(verbose.every((move) => move.promotion !== undefined)).toEqual(true)
+  }
+})
