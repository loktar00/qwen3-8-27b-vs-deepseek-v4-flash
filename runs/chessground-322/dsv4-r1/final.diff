diff --git a/tests/drawable.test.ts b/tests/drawable.test.ts
new file mode 100644
index 0000000..f613633
--- /dev/null
+++ b/tests/drawable.test.ts
@@ -0,0 +1,59 @@
+import * as drag from '../src/drag';
+import { defaults, type State } from '../src/state';
+import type * as cg from '../src/types';
+import * as util from '../src/util';
+
+const bounds = { left: 0, top: 0, width: 8, height: 8 } as DOMRectReadOnly;
+
+const makeState = (eraseOnClick: boolean): State => {
+  const state = defaults() as State;
+  state.drawable.eraseOnClick = eraseOnClick;
+  state.drawable.shapes = [{ orig: 'a1', dest: 'h8', brush: 'green' }];
+  state.dom = {
+    elements: {
+      board: { firstChild: null } as unknown as HTMLElement,
+      ghost: null as unknown as HTMLElement,
+    } as cg.Elements,
+    bounds: () => bounds,
+    redraw: () => {},
+    redrawNow: () => {},
+  };
+  return state;
+};
+
+const clickAt = (key: cg.Key): cg.MouchEvent =>
+  ({
+    isTrusted: true,
+    buttons: 0,
+    ctrlKey: false,
+    cancelable: true,
+    clientX: util.computeSquareCenter(key, true, bounds)[0],
+    clientY: util.computeSquareCenter(key, true, bounds)[1],
+    preventDefault: () => {},
+    target: null,
+    type: 'mousedown',
+  }) as unknown as cg.MouchEvent;
+
+test('clicking an empty square does not clear shapes when eraseOnClick is false', () => {
+  const state = makeState(false);
+  drag.start(state, clickAt('e4')); // empty square in the initial position
+  expect(state.drawable.shapes).toHaveLength(1);
+});
+
+test('clicking an opponent piece does not clear shapes when eraseOnClick is false', () => {
+  const state = makeState(false);
+  drag.start(state, clickAt('e7')); // black pawn, white to play
+  expect(state.drawable.shapes).toHaveLength(1);
+});
+
+test('clicking a movable piece does not clear shapes when eraseOnClick is false', () => {
+  const state = makeState(false);
+  drag.start(state, clickAt('e2')); // white pawn, white to play
+  expect(state.drawable.shapes).toHaveLength(1);
+});
+
+test('clicking clears shapes when eraseOnClick is true', () => {
+  const state = makeState(true);
+  drag.start(state, clickAt('e4'));
+  expect(state.drawable.shapes).toHaveLength(0);
+});
