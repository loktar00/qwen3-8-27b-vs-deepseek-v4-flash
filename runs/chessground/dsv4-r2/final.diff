diff --git a/tests/dom.test.ts b/tests/dom.test.ts
new file mode 100644
index 0000000..30851ea
--- /dev/null
+++ b/tests/dom.test.ts
@@ -0,0 +1,71 @@
+import { Chessground } from '../src/chessground';
+
+// jsdom has no native ResizeObserver. Install a recording mock so we can
+// assert that observers are created per board and disconnected on redraw and
+// on destroy.
+class MockResizeObserver {
+  static instances: MockResizeObserver[] = [];
+  observed = new Set<Element>();
+  disconnected = false;
+  constructor(_callback: ResizeObserverCallback) {
+    MockResizeObserver.instances.push(this);
+  }
+  observe(el: Element): void {
+    this.observed.add(el);
+  }
+  unobserve(el: Element): void {
+    this.observed.delete(el);
+  }
+  disconnect(): void {
+    this.disconnected = true;
+    this.observed.clear();
+  }
+}
+
+const lastInstance = (): MockResizeObserver =>
+  MockResizeObserver.instances[MockResizeObserver.instances.length - 1];
+
+beforeEach(() => {
+  MockResizeObserver.instances = [];
+  vi.stubGlobal('ResizeObserver', MockResizeObserver);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+test('destroy disconnects the ResizeObserver', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const cg = Chessground(wrap, { viewOnly: true });
+
+  const ro = lastInstance();
+  expect(ro.disconnected).toBe(false);
+  expect(ro.observed.has(wrap)).toBe(true);
+
+  cg.destroy();
+
+  expect(ro.disconnected).toBe(true);
+  expect(ro.observed.size).toBe(0);
+  wrap.remove();
+});
+
+test('redraw disconnects the previous ResizeObserver', () => {
+  const wrap = document.createElement('div');
+  document.body.appendChild(wrap);
+  const cg = Chessground(wrap, { viewOnly: true });
+
+  const first = lastInstance();
+  cg.redrawAll();
+  const second = lastInstance();
+
+  expect(MockResizeObserver.instances.length).toBe(2);
+  expect(first.disconnected).toBe(true);
+  expect(first.observed.size).toBe(0);
+  expect(second.disconnected).toBe(false);
+  expect(second.observed.has(wrap)).toBe(true);
+
+  cg.destroy();
+  expect(second.disconnected).toBe(true);
+  wrap.remove();
+});
